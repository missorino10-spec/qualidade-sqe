node_modules/

# Build
dist/
build/
*.tsbuildinfo

# Ambiente
.env

# Uploads locais (fora do Docker)
uploads/

# Dumps tirados antes de limpeza no banco: contem dado real, nao versionar
backup/

# Saida do importar-base-itens.js: sao os 14 mil codigos reais da fabrica COM
# custo unitario. E dado comercial da empresa, nao codigo. O script regera o
# arquivo a partir da planilha quando for preciso.
backend/prisma/seed-base-itens.sql

# Fotografia da API (scripts/fotografia.js): e a resposta crua das telas com
# dado de producao e so vale para a maquina e o dia em que foi tirada.
scripts/fotografia/

# Prisma
*.db

# Logs
*.log
npm-debug.log*

# Editor / SO
.DS_Store
.vscode/
.idea/

# Configuracao local do assistente. Guarda o historico de comandos liberados,
