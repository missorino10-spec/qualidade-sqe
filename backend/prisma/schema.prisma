// ============================================================
// Sistema de Qualidade - Big Dutchman Brasil
// Schema do banco de dados (PostgreSQL)
// Nucleo compartilhado + Modulo SQE (recebimento de fornecedores)
//                      + Modulo MANUFATURA (setup, producao, CNQ, 8D)
//                      + Modulo SQD (homologacao de fornecedores e itens)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL: conexao direta (porta 5432), usada SOMENTE para criar/alterar
  // tabelas. A DATABASE_URL aponta para o pooler em modo transaction (6543),
  // otimo para a aplicacao mas incapaz de executar DDL e advisory locks.
  directUrl = env("DIRECT_URL")
}

// ---------------------- NUCLEO ----------------------

enum Papel {
  QUALIDADE
  PRODUCAO
  ADMIN
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel    @default(QUALIDADE)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  planejamentos   PlanejamentoSemanal[] @relation("PlanejamentoCriadoPor")
  entregas        EntregaPortaria[]     @relation("EntregaConfirmadoPor")
  inspecoesVisual InspecaoVisual[]      @relation("InspVisualInspetor")
  inspecoesLote   InspecaoLote[]        @relation("InspLoteInspetor")
  rncs            Rnc[]                 @relation("RncCriadoPor")
  anexos          Anexo[]
  historicos      HistoricoStatus[]

  // Manufatura
  inspecoesManufatura    InspecaoManufatura[]   @relation("InspManufaturaInspetor")
  relatoriosDimensionais RelatorioDimensional[] @relation("RelatorioInspetor")
  producaoRegistrada     ProducaoDiaria[]       @relation("ProducaoRegistradaPor")
  cnqs                   Cnq[]                  @relation("CnqCriadoPor")
  oitoDsCriados          OitoD[]                @relation("OitoDCriadoPor")
  oitoDsAprovados        OitoD[]                @relation("OitoDAprovadoPor")

  // SQD
  homologacoes HomologacaoFornecedor[] @relation("HomologacaoCriadoPor")
}

// Classificacao de fornecimento (definida manualmente, base no trimestre anterior)
enum Classificacao {
  A
  B
  C
  D
}

enum EsforcoQualidade {
  BAIXO
  MEDIO
  ALTO
}

model Fornecedor {
  id     Int     @id @default(autoincrement())
  codigo String  @unique
  nome   String
  cnpj   String?

  // Dados complementares (opcionais no MVP)
  endereco String?

  // Escopo / classificacao (planilha "Escopo" + "Base de Fornecedores")
  tipoFornecimento    String? // ex: Paineis eletricos, Materia-prima, Parafusos
  categoriaInspecao   String? // ex: Eletrico/Montagem, Plastico injetado, Fixadores
  planoInspecao       String? // resumo textual do escopo
  controlesPrincipais String? // texto detalhado do que checar
  escopoTexto         String? // texto livre do escopo (aba Escopo)
  esforcoQualidade    EsforcoQualidade @default(MEDIO)

  // Classificacao de fornecimento (manual) - define periodicidade/nivel/NQA
  classificacaoFornecimento Classificacao @default(C)
  // Cadastro pontual (ex: importacao) feito na hora de uma inspecao extra.
  // Fica FORA do plano de periodicidade, mas os desvios contam nos indicadores.
  // Quando um dia for homologado, basta desmarcar - o cadastro ja existe.
  eventual                  Boolean       @default(false)
  // Escopo de inspeicao: quais formularios o sistema deve abrir
  fazVisual                 Boolean       @default(true)
  fazLote                   Boolean       @default(false)

  // Contadores
  contadorEntregas   Int @default(0) // ciclico: zera quando dispara inspecao
  totalEntregas      Int @default(0) // acumulado historico (dashboard)
  totalInspecoes     Int @default(0) // acumulado historico (dashboard)
  lotesInspecionados Int @default(0) // trimestre corrente
  lotesReprovados    Int @default(0) // trimestre corrente

  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  contatos         Contato[]
  itens            Item[]
  planejamentos    PlanejamentoSemanal[]
  entregas         EntregaPortaria[]
  inspecoesVisual  InspecaoVisual[]
  inspecoesLote    InspecaoLote[]
  rncs             Rnc[]
  historicoClasses HistoricoClassificacao[]
}

// Ate 2 contatos por fornecedor (cadastro simples)
model Contato {
  id           Int        @id @default(autoincrement())
  fornecedorId Int
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  nome         String
  email        String?
  telefone     String?
  funcao       String?

  @@index([fornecedorId])
}

model Item {
  id           Int         @id @default(autoincrement())
  codigo       String      @unique
  descricao    String
  unidade      String?
  fornecedorId Int?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])
  createdAt    DateTime    @default(now())

  planejamentos   PlanejamentoSemanal[]
  entregas        EntregaPortaria[]
  inspecoesVisual InspecaoVisual[]
  inspecoesLote   InspecaoLote[]
  rncs            Rnc[]
}

// Tabela de referencia de periodicidade por classificacao (pre-setada e editavel)
model PeriodicidadeConfig {
  id                 Int           @id @default(autoincrement())
  classificacao      Classificacao @unique
  periodicidadeTexto String // ex: "1 a cada 5 entregas"
  frequenciaN        Int // 5, 3, 1
  tipoInspecao       String        @default("Amostragem")
  nivelInspecaoTexto String // ex: "Inspecao Reduzida (30% itens)"
  nivelRomano        String // I, II, III
  percentualAmostra  Int // 30, 50, 100
  nqa                Float // 4.0, 2.5, 1.0
  // bandas de conformidade para reclassificacao
  conformidadeMin    Float // A>=98, B>=90, C>=80, D>=0
  updatedAt          DateTime      @updatedAt
}

// Anexo polimorfico: serve para qualquer entidade (Inspecao, RNC, modulos futuros)
model Anexo {
  id           Int      @id @default(autoincrement())
  entidadeTipo String // ex: "RNC", "INSPECAO_VISUAL", "INSPECAO_LOTE"
  entidadeId   Int
  nomeArquivo  String
  caminho      String
  mimeType     String?
  tamanho      Int?
  uploadedById Int?
  uploadedBy   Usuario? @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([entidadeTipo, entidadeId])
}

// Historico de status polimorfico: registra toda mudanca de status de qualquer entidade
model HistoricoStatus {
  id             Int      @id @default(autoincrement())
  entidadeTipo   String // ex: "RNC"
  entidadeId     Int
  statusAnterior String?
  statusNovo     String
  comentario     String?
  usuarioId      Int?
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt      DateTime @default(now())

  @@index([entidadeTipo, entidadeId])
}

// Historico de classificacao por trimestre fiscal (out->set)
model HistoricoClassificacao {
  id                   Int           @id @default(autoincrement())
  fornecedorId         Int
  fornecedor           Fornecedor    @relation(fields: [fornecedorId], references: [id])
  trimestreFiscal      String // ex: "FY26-Q3"
  periodoInicio        DateTime
  periodoFim           DateTime
  classificacaoInicial Classificacao // classificacao de fornecimento do periodo
  lotesInspecionados   Int
  lotesReprovados      Int
  pctConformidade      Float
  classificacaoApurada Classificacao // calculada pela conformidade
  createdAt            DateTime      @default(now())

  @@index([fornecedorId])
}

// ---------------------- MODULO SQE ----------------------

enum StatusPlanejamento {
  PENDENTE
  ENTREGUE
}

model PlanejamentoSemanal {
  id               Int                @id @default(autoincrement())
  semanaReferencia String // ex: "2026-W28"
  fornecedorId     Int
  fornecedor       Fornecedor         @relation(fields: [fornecedorId], references: [id])
  itemId           Int?
  item             Item?              @relation(fields: [itemId], references: [id])
  dataPrevista     DateTime?
  status           StatusPlanejamento @default(PENDENTE)
  criadoPorId      Int?
  criadoPor        Usuario?           @relation("PlanejamentoCriadoPor", fields: [criadoPorId], references: [id])
  createdAt        DateTime           @default(now())

  entregas EntregaPortaria[]
}

// Um recebimento. Quando ele e inspecionado, ganha um numero de inspecao
// (INSP0001/2026) e passa a ser a UNIDADE de inspecao: os formularios Visual e
// Lote do mesmo recebimento sao a MESMA inspecao, contam como uma so e
// compartilham uma unica RNC.
model EntregaPortaria {
  id                     Int                  @id @default(autoincrement())
  planejamentoId         Int?
  planejamento           PlanejamentoSemanal? @relation(fields: [planejamentoId], references: [id])
  fornecedorId           Int
  fornecedor             Fornecedor           @relation(fields: [fornecedorId], references: [id])
  itemId                 Int?
  item                   Item?                @relation(fields: [itemId], references: [id])
  dataEntrega            DateTime             @default(now())
  semanaReferencia       String? // W do recebimento (domingo->sabado)
  semana                 String? // semana no formato W## (ex: W28)
  ano                    Int? // ano do recebimento
  notaFiscal             String?
  po                     String?
  quantidade             Float?
  // Decisao automatica de inspecao
  numeroEntregaAcumulado Int? // valor do contador no momento
  passivelInspecao       Boolean              @default(false) // sistema decidiu inspecionar?

  // Identificacao da inspecao (nula enquanto o recebimento nao for inspecionado)
  numeroInspecao     String? @unique // formato INSP0001/2026
  inspecaoAno        Int? // ano da inspecao (sequencial reinicia por ano)
  inspecaoSequencial Int? // sequencial dentro do ano
  // Inspecao fora do ciclo de periodicidade: fornecedor eventual OU fornecedor
  // da base inspecionado dentro da janela em que o sistema nao sugeriria.
  inspecaoExtra      Boolean @default(false)

  confirmadoPorId Int?
  confirmadoPor   Usuario? @relation("EntregaConfirmadoPor", fields: [confirmadoPorId], references: [id])
  createdAt       DateTime @default(now())

  inspecoesVisual InspecaoVisual[]
  inspecoesLote   InspecaoLote[]
  rncs            Rnc[]

  @@unique([inspecaoAno, inspecaoSequencial])
}

enum ResultadoInspecao {
  APROVADO
  REPROVADO
}

enum OrigemInspecao {
  PLANO_INSPECAO
  HOMOLOGACAO
  DEVOLUCAO
  RETRABALHO
  RELATORIO_OCORRENCIA
  LIBERACAO_SETUP
  OUTROS
}

// Formulario VISUAL - Doc BDBR.QUA.FMR.06.07
// Checklist de 12 grupos armazenado em JSON (fiel a planilha)
model InspecaoVisual {
  id           Int              @id @default(autoincrement())
  entregaId    Int?
  entrega      EntregaPortaria? @relation(fields: [entregaId], references: [id])
  fornecedorId Int
  fornecedor   Fornecedor       @relation(fields: [fornecedorId], references: [id])
  itemId       Int
  item         Item             @relation(fields: [itemId], references: [id])

  // Cabecalho comum
  desenhoRev      String?
  toleranciasNorm String?
  notaFiscal      String?
  po              String?
  qtdInspecionada Float?
  qtdTotal        Float?
  relatorioNumero String?
  origem          OrigemInspecao @default(PLANO_INSPECAO)

  // Checklist (12 grupos) - JSON: [{ grupo, itens: [{ texto, status }] }]
  checklist Json

  observacoes  String?
  resultado    ResultadoInspecao @default(APROVADO)
  dataInspecao DateTime          @default(now())
  semana       String? // semana da inspecao no formato W## (ex: W28)
  ano          Int? // ano da inspecao
  inspetorId   Int?
  inspetor     Usuario?          @relation("InspVisualInspetor", fields: [inspetorId], references: [id])
  createdAt    DateTime          @default(now())

  rncs Rnc[]
}

// Formulario LOTE / DIMENSIONAL - Doc BDBR.QUA.FMR.011.06
model InspecaoLote {
  id           Int              @id @default(autoincrement())
  entregaId    Int?
  entrega      EntregaPortaria? @relation(fields: [entregaId], references: [id])
  fornecedorId Int
  fornecedor   Fornecedor       @relation(fields: [fornecedorId], references: [id])
  itemId       Int
  item         Item             @relation(fields: [itemId], references: [id])

  // Cabecalho comum
  desenhoRev      String?
  toleranciasNorm String?
  notaFiscal      String?
  po              String?
  qtdInspecionada Float?
  qtdTotal        Float?
  relatorioNumero String?
  origem          OrigemInspecao @default(PLANO_INSPECAO)

  // Tabela de cotas - JSON: [{ localizacao, especificado, tolUpper, tolLower, pecas:[..], instrumento, desvioMin, desvioMax }]
  cotas Json

  observacoes  String?
  resultado    ResultadoInspecao @default(APROVADO)
  dataInspecao DateTime          @default(now())
  semana       String? // semana da inspecao no formato W## (ex: W28)
  ano          Int? // ano da inspecao
  inspetorId   Int?
  inspetor     Usuario?          @relation("InspLoteInspetor", fields: [inspetorId], references: [id])
  createdAt    DateTime          @default(now())

  rncs Rnc[]
}

// RNC - Doc BDBR.QUA.FMR.003.03 (controle interno)
enum StatusRnc {
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

enum VerificacaoEficacia {
  PENDENTE
  APROVADO
  REPROVADO
  NAO_APLICAVEL
}

enum NivelPlano {
  RUIM
  SATISFATORIO
  EXCELENTE
  NAO_APLICAVEL
}

model Rnc {
  id         Int    @id @default(autoincrement())
  numero     String @unique // formato RNC0001/2026
  ano        Int // ano da RNC (para gerar sequencial por ano)
  sequencial Int // sequencial dentro do ano

  // origem (inspecao reprovada). A entrega e a inspecao a que a RNC pertence:
  // e por ela que se garante UMA RNC por inspecao, mesmo quando Visual e Lote
  // sao reprovados. Os dois campos abaixo dizem QUAL formulario reprovou.
  entregaId        Int?
  entrega          EntregaPortaria? @relation(fields: [entregaId], references: [id])
  inspecaoVisualId Int?
  inspecaoVisual   InspecaoVisual?  @relation(fields: [inspecaoVisualId], references: [id])
  inspecaoLoteId   Int?
  inspecaoLote     InspecaoLote?    @relation(fields: [inspecaoLoteId], references: [id])

  // Informacoes do documento
  dataAbertura DateTime @default(now())
  semana       String? // semana da abertura no formato W## (ex: W28)
  solicitante  String   @default("Qualidade")

  // Informacoes do item
  itemId         Int
  item           Item    @relation(fields: [itemId], references: [id])
  quantidadeLote Float?
  po             String?
  notaFiscal     String?

  // Informacoes do fornecedor
  fornecedorId Int
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])

  // Informacoes sobre o desvio
  tipoDesvio      String // texto livre
  reincidencia    Boolean @default(false)
  descricaoDesvio String

  // Custos RNC
  quantidadePecas Float?
  valorUnitario   Float?
  valorTotal      Float? // = quantidadePecas * valorUnitario

  // Plano de acao
  disposicao            String? // texto livre
  houveRetorno          Boolean?
  dataRetorno           DateTime?
  tempoRetornoDias      Int? // = dataRetorno - dataAbertura
  fornecedorAceitou     String? // "Sim" / "Nao (Ver observacoes)"
  fornecedorEnviouPlano Boolean?
  nivelPlano            NivelPlano?
  status                StatusRnc           @default(EM_ANDAMENTO)
  motivoCancelamento    String? // motivo quando status = CANCELADA
  verificacaoEficacia   VerificacaoEficacia @default(PENDENTE)
  dataVerificacao       DateTime?

  evidencias  String?
  observacoes String?

  criadoPorId Int?
  criadoPor   Usuario? @relation("RncCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([ano, sequencial])
}

// ---------------------- MODULO MANUFATURA ----------------------

// A planilha de indicadores cobre duas areas com naturezas diferentes:
// FABRICACAO trabalha por maquina (Prensa 100, Laser...) e MONTAGEM por linha
// (Linha 1, Linha 2...). As duas sao inspecionadas pelos mesmos formularios,
// entao ficam no mesmo cadastro, separadas pelo campo area.
enum AreaManufatura {
  FABRICACAO
  MONTAGEM
}

model Maquina {
  id     Int            @id @default(autoincrement())
  codigo String         @unique
  nome   String
  area   AreaManufatura @default(FABRICACAO)

  // Prioridade/criticidade definida manualmente pela Qualidade (nao e
  // recalculada pelo sistema, ao contrario da classificacao do fornecedor).
  classificacao Classificacao @default(C)

  // Todo setup e inspecionado. O contador conta os setups para cobrar a
  // inspecao de PRODUCAO: a cada N setups, a producao precisa ser inspecionada.
  frequenciaProducaoN Int @default(1)
  contadorSetups      Int @default(0)

  // Acumulados do trimestre corrente (zerados no fechamento)
  setupsRealizados    Int @default(0)
  producoesRealizadas Int @default(0)
  inspecoesReprovadas Int @default(0)

  descricao String?
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  producaoDiaria ProducaoDiaria[]
  inspecoes      InspecaoManufatura[]
  cnqs           Cnq[]
  historico      HistoricoMaquina[]
}

// Apontamento diario que os operadores entregam em papel e a Qualidade digita.
// E a base do PPM: (qtdDefeito / qtdProduzida) * 1.000.000.
model ProducaoDiaria {
  id           Int      @id @default(autoincrement())
  maquinaId    Int
  maquina      Maquina  @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  data         DateTime @db.Date
  qtdProduzida Float    @default(0)
  qtdDefeito   Float    @default(0)

  registradoPorId Int?
  registradoPor   Usuario? @relation("ProducaoRegistradaPor", fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([maquinaId, data])
  @@index([data])
}

// Lista oficial de "Descricao do Defeito" (aba Defeitos e CNQ). Cadastravel
// para a Qualidade ajustar sem depender de deploy.
model TipoDefeito {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  ordem Int     @default(0)
  ativo Boolean @default(true)

  cnqs Cnq[]
}

enum TipoInspecaoManufatura {
  SETUP
  PRODUCAO
}

// Resultado dos formularios da manufatura. Diferente do SQE, existe o
// "aprovado com observacao": o item passa, mas com ressalva registrada.
// Para os indicadores ele conta como aprovado.
enum ResultadoManufatura {
  APROVADO
  APROVADO_COM_OBSERVACAO
  REPROVADO
}

enum StatusInspecaoManufatura {
  PENDENTE
  APROVADA
  APROVADA_COM_OBSERVACAO
  REPROVADA
}

// A inspecao-mae. Reprovar NAO encerra: a inspecao fica PENDENTE e recebe um
// novo RelatorioDimensional (tentativa 2, 3...) ate aprovar. Todas as
// tentativas ficam guardadas aqui e saem juntas no PDF.
model InspecaoManufatura {
  id     Int                    @id @default(autoincrement())
  tipo   TipoInspecaoManufatura
  numero String                 @unique // SET0001/2026 ou PROD0001/2026 (numero da 1a tentativa)

  maquinaId Int
  maquina   Maquina @relation(fields: [maquinaId], references: [id])

  // Item digitado livre (a base interna de itens entra depois)
  itemCodigo    String?
  itemDescricao String?
  po            String?

  // Inspecao de producao pode referenciar o setup que a antecedeu (opcional,
  // so como rastreabilidade - nao altera status nem indicador).
  setupId   Int?
  setup     InspecaoManufatura?  @relation("ProducaoDoSetup", fields: [setupId], references: [id])
  producoes InspecaoManufatura[] @relation("ProducaoDoSetup")

  // Producao inspecionada antes de o contador de setups atingir o N da maquina.
  extra Boolean @default(false)

  status       StatusInspecaoManufatura @default(PENDENTE)
  dataInspecao DateTime                 @default(now())
  semana       String?
  ano          Int?

  inspetorId Int?
  inspetor   Usuario? @relation("InspManufaturaInspetor", fields: [inspetorId], references: [id])
  createdAt  DateTime @default(now())

  relatorios RelatorioDimensional[]
  oitoDs     OitoD[]

  @@index([tipo, dataInspecao])
}

// RELATORIO DE INSPECAO DIMENSIONAL - Doc BDBR.QUA.FMR.011.06 (rev. 06).
// Espelha o formulario campo a campo. Cada tentativa e um relatorio completo,
// com numero proprio tirado da mesma serie da inspecao.
model RelatorioDimensional {
  id         Int                @id @default(autoincrement())
  inspecaoId Int
  inspecao   InspecaoManufatura @relation(fields: [inspecaoId], references: [id], onDelete: Cascade)

  // tipo repetido aqui (e nao so na inspecao-mae) para que a numeracao
  // SET/PROD possa ter unicidade garantida pelo banco.
  tipo       TipoInspecaoManufatura
  numero     String                 @unique
  ano        Int
  sequencial Int
  tentativa  Int                    @default(1)

  // "Rev." do proprio relatorio, preenchido a mao (comeca em 01)
  revisao String @default("01")

  dataInspecao DateTime       @default(now())
  origem       OrigemInspecao @default(LIBERACAO_SETUP)
  origemOutros String? // texto do campo "Outros:"

  itemCodigo      String?
  itemDescricao   String?
  desenhoRev      String?
  po              String?
  qtdInspecionada Float?
  qtdTotal        Float?

  // Cotas do formulario. Uma coluna "Encontrado" por peca inspecionada:
  // [{ localizacao, especificado, tolerancia, upper, lower, pecas: [n1, n2, n3],
  //    instrumento, desvioMin, desvioMax }]
  cotas Json

  observacoesFinais   String?
  resultado           ResultadoManufatura @default(APROVADO)
  // Texto obrigatorio quando o resultado e APROVADO_COM_OBSERVACAO
  observacaoResultado String?

  // Bloco de desvio (aparece quando ha ressalva ou reprova):
  // defeitos e um array com os nomes da lista oficial de tipos de defeito.
  defeitos        Json?
  qtdAfetada      Float?
  descricaoDesvio String?

  elaboradoPor    String?
  inspecionadoPor String?
  inspetorId      Int?
  inspetor        Usuario? @relation("RelatorioInspetor", fields: [inspetorId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([tipo, ano, sequencial])
  @@index([inspecaoId])
}

// CNQ - Custo da Nao Qualidade. Espelha a aba "Defeitos e CNQ": um lancamento
// por apontamento de operador. Independente das inspecoes.
model Cnq {
  id         Int    @id @default(autoincrement())
  numero     String @unique // CNQ0001/2026
  ano        Int
  sequencial Int

  data      DateTime @db.Date
  maquinaId Int
  maquina   Maquina  @relation(fields: [maquinaId], references: [id])

  itemCodigo    String
  itemDescricao String?

  tipoDefeitoId Int
  tipoDefeito   TipoDefeito @relation(fields: [tipoDefeitoId], references: [id])

  quantidade    Float
  // Valor da peca digitado no lancamento (nao ha base de precos ainda)
  valorUnitario Float @default(0)
  valorTotal    Float @default(0) // = quantidade * valorUnitario

  observacoes String?
  acao        String?

  criadoPorId Int?
  criadoPor   Usuario? @relation("CnqCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  oitoDs OitoD[]

  @@unique([ano, sequencial])
  @@index([data])
}

// FORMULARIO 8D - Doc BDBR.QUA.FMR.007.01 (rev. 1)
enum StatusOitoD {
  AGUARDANDO
  EM_ANDAMENTO
  CONCLUIDO
}

enum OrigemOitoD {
  RELATORIO_RO
  PRODUCAO
  INSPECAO_EXTRA
  SETUP
}

enum TurnoManufatura {
  COMERCIAL
  SEGUNDO_TURNO
}

model OitoD {
  id         Int    @id @default(autoincrement())
  numero     String @unique // 8D0001/2026
  ano        Int
  sequencial Int

  // Opcional: nasce de uma inspecao com desvio OU de um lancamento de CNQ
  inspecaoId Int?
  inspecao   InspecaoManufatura? @relation(fields: [inspecaoId], references: [id])
  cnqId      Int?
  cnq        Cnq?                @relation(fields: [cnqId], references: [id])

  // 1. Dados / cabecalho
  empresaUnidade    String          @default("Big Dutchman Brasil")
  dataAbertura      DateTime        @default(now())
  status            StatusOitoD     @default(AGUARDANDO)
  produtoItem       String?
  codigoDesenho     String?
  origem            OrigemOitoD     @default(PRODUCAO)
  local             String?
  processoOperacao  String?
  equipamento       String?
  turno             TurnoManufatura @default(COMERCIAL)
  qtdAfetada        String?
  responsavel       String?
  equipe            String?
  descricaoProblema String?

  // 2. Analise de causa raiz
  efeito   String?
  // 6M: { maquina, metodo, material, maoDeObra, medicao, meioAmbiente }
  causas6M Json?
  // 5 Porques: ["...", "...", ...]
  porques  Json?

  // 3. Causa raiz confirmada
  causaRaiz String?

  // 4. Plano de acao corretiva
  // [{ id, acao, tipo, responsavel, prazo, status, evidencia, observacoes }]
  planoAcao Json?

  // 5. Padronizacao
  // [{ documento, alteracao, responsavel, prazo, treinamento, registro, status, observacoes }]
  padronizacao Json?

  // 6. Evidencias antes/depois: anexos com entidadeTipo
  //    "OITOD_ANTES" e "OITOD_DEPOIS" (1 foto cada)

  // 7. Verificacao da eficacia
  // [{ criterio, metodo, amostra, esperado, obtido, data, responsavel, eficaz }]
  verificacaoEficacia Json?

  // Aprovacoes: so a Qualidade aprova no sistema (com registro de quem e
  // quando). O campo da Producao continua no PDF, identico ao papel.
  aprovadoPorId     Int?
  aprovadoPor       Usuario?  @relation("OitoDAprovadoPor", fields: [aprovadoPorId], references: [id])
  aprovadoEm        DateTime?
  aprovacaoProducao String?

  criadoPorId Int?
  criadoPor   Usuario? @relation("OitoDCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([ano, sequencial])
}

// Snapshot do trimestre fiscal por maquina. A classificacao NAO e recalculada
// (e manual, definida pela Qualidade): o fechamento congela os numeros do
// periodo e zera os contadores.
model HistoricoMaquina {
  id        Int     @id @default(autoincrement())
  maquinaId Int
  maquina   Maquina @relation(fields: [maquinaId], references: [id])

  trimestreFiscal String
  periodoInicio   DateTime
  periodoFim      DateTime

  classificacao       Classificacao
  pecasProduzidas     Float
  pecasComDefeito     Float
  ppm                 Float
  cnqTotal            Float
  setupsRealizados    Int
  producoesRealizadas Int
  inspecoesReprovadas Int

  createdAt DateTime @default(now())

  @@index([maquinaId])
}

// ---------------------- MODULO SQD ----------------------
// Homologacao de fornecedores: a autoavaliacao (self audit) do documento
// BDBR.QUA.FMR.024.03 e o controle do BDBR.QUA.FMR.029.01 sao o MESMO
// registro, aberto pelo mesmo numero (AUT0001/2026).

enum ResultadoHomologacao {
  APROVADO
  APROVADO_CONDICIONALMENTE
  REPROVADO
}

enum StatusHomologacao {
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
}

enum StatusPlanoAcaoSqd {
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
  NAO_APLICAVEL
}

// Criterios de efetividade descritos na aba "Base de Dados" do FMR.029.01
enum EfetividadePlanoAcao {
  NAO_APLICAVEL_CANCELADO
  NAO_IMPLEMENTADO_ATRASADO
  EFETIVO
  PARCIALMENTE_EFETIVO
  INEFICAZ
}

enum SolicitanteSqd {
  COMPRAS
  ENGENHARIA
  NC
}

model HomologacaoFornecedor {
  id         Int    @id @default(autoincrement())
  numero     String @unique // AUT0001/2026
  ano        Int
  sequencial Int
  semana     String // W28 - mesma regra de semana do SQE e da Manufatura

  // --- Cabecalho da autoavaliacao (FMR.024.03, pagina 01 de 03) ---
  fornecedorNome    String
  cnpj              String?
  inscricaoEstadual String?
  responsavelInfo   String?
  setor             String?
  dataAvaliacao     DateTime

  // Respostas do fornecedor: [{ codigo: "A1", resposta: "SIM"|"NAO"|"NA" }]
  respostas Json

  // Resultado calculado (abas "Criterios" e "Resultados"):
  // [{ bloco, nome, peso, pontuacao, ponderada, critico, reprovadas: [...] }]
  blocos    Json
  nota      Float // nota ponderada final, 0 a 100
  resultado ResultadoHomologacao

  // --- Registro de homologacao (FMR.029.01, aba "2026") ---
  codigoFornecedor       String?
  solicitante            SolicitanteSqd?
  segmento               String?
  escopoFornecedor       String?
  processosTerceirizados String?
  dataSolicitacao        DateTime?
  dataEnvioRelatorio     DateTime?
  leadTimeDiasUteis      Int? // calculado: dias uteis entre solicitacao e envio
  statusHomologacao      StatusHomologacao     @default(EM_ANDAMENTO)
  statusPlanoAcao        StatusPlanoAcaoSqd?
  dataReavaliacao        DateTime?
  efetividadePlanoAcao   EfetividadePlanoAcao?
  acao                   String?
  observacoes            String?

  // Anexos (tabela polimorfica Anexo):
  //   "HOMOLOGACAO_RELATORIO"   - relatorio final escrito pela Qualidade
  //   "HOMOLOGACAO_PLANO_ACAO"  - plano de acao enviado pelo fornecedor

  criadoPorId Int?
  criadoPor   Usuario? @relation("HomologacaoCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ano, sequencial])
  @@index([dataAvaliacao])
}
