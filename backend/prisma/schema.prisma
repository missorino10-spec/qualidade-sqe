// ============================================================
// Sistema de Qualidade - Big Dutchman Brasil
// Schema do banco de dados (PostgreSQL)
// Nucleo compartilhado + Modulo SQE (recebimento de fornecedores)
//                      + Modulo MANUFATURA (setup, producao, CNQ, 8D)
//                      + Modulo SQD (homologacao de fornecedores e itens)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL: conexao direta (porta 5432), usada SOMENTE para criar/alterar
  // tabelas. A DATABASE_URL aponta para o pooler em modo transaction (6543),
  // otimo para a aplicacao mas incapaz de executar DDL e advisory locks.
  directUrl = env("DIRECT_URL")
}

// ---------------------- NUCLEO ----------------------

enum Papel {
  QUALIDADE
  PRODUCAO
  ADMIN
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel    @default(QUALIDADE)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  // Ficha do colaborador: o admin cadastra a pessoa da empresa e o e-mail
  // daqui e o login dela.
  matricula    String?
  cargo        String?
  setor        String?
  telefone     String?
  dataAdmissao DateTime?

  // Senha provisoria entregue pelo admin: no primeiro acesso o sistema abre a
  // troca de senha antes de deixar entrar.
  precisaTrocarSenha Boolean @default(false)

  acessos AcessoModulo[]

  entregas        EntregaPortaria[] @relation("EntregaConfirmadoPor")
  inspecoesVisual InspecaoVisual[]  @relation("InspVisualInspetor")
  inspecoesLote   InspecaoLote[]    @relation("InspLoteInspetor")
  rncs            Rnc[]             @relation("RncCriadoPor")

  avaliacoesFornecedor AvaliacaoFornecedor[] @relation("AvaliacaoFornecedorPor")
  anexos          Anexo[]
  historicos      HistoricoStatus[]

  // Manufatura
  inspecoesManufatura    InspecaoManufatura[]   @relation("InspManufaturaInspetor")
  relatoriosDimensionais RelatorioDimensional[] @relation("RelatorioInspetor")

  inspecoesVisualManufatura InspecaoVisualManufatura[] @relation("InspVisualManufaturaInspetor")

  producaoRegistrada ProducaoDiaria[]  @relation("ProducaoRegistradaPor")
  cnqs               Cnq[]             @relation("CnqCriadoPor")
  oitoDsCriados      OitoD[]           @relation("OitoDCriadoPor")
  oitoDsAprovados    OitoD[]           @relation("OitoDAprovadoPor")
  cincoGsCriados     CincoG[]          @relation("CincoGCriadoPor")
  cincoGsAprovados   CincoG[]          @relation("CincoGAprovadoPor")
  alertasCriados     AlertaQualidade[] @relation("AlertaCriadoPor")
  alertasEncerrados  AlertaQualidade[] @relation("AlertaEncerradoPor")
  renovacoesAlerta   RenovacaoAlerta[] @relation("RenovacaoAlertaCriadoPor")

  icaqAuditados ControleAutonomo[] @relation("IcaqAuditor")
  icaqCriados   ControleAutonomo[] @relation("IcaqCriadoPor")

  // SQD
  homologacoes           HomologacaoFornecedor[] @relation("HomologacaoCriadoPor")
  homologacoesItem       HomologacaoItem[]       @relation("HomologacaoItemCriadoPor")
  relatoriosInspecaoItem RelatorioInspecaoItem[] @relation("RelatorioItemCriadoPor")
  auditoriasFornecedor   AuditoriaFornecedor[]   @relation("AuditoriaCriadoPor")
  rodadasAuditoria       RodadaAuditoria[]       @relation("RodadaAuditoriaCriadoPor")

  // R.O
  reclamacoes            Reclamacao[]      @relation("ReclamacaoCriadoPor")
  reclamacoesResponsavel Reclamacao[]      @relation("ReclamacaoResponsavel")
  blocosReclamacao       BlocoReclamacao[] @relation("BlocoReclamacaoConcluidoPor")

  // Metrologia
  instrumentos Instrumento[] @relation("InstrumentoCriadoPor")

  // Calendario de feriados
  feriados Feriado[] @relation("FeriadoCriadoPor")
}

// O que o admin libera para cada colaborador. SQE, MANUFATURA e SQD sao o
// modulo inteiro; CADASTROS e liberado submenu a submenu, porque quem mexe no
// cadastro base costuma ser um grupo bem menor de gente.
enum ModuloSistema {
  SQE
  MANUFATURA
  SQD
  RO
  CAD_FORNECEDORES
  CAD_ITENS
  CAD_MAQUINAS
  CAD_INSTRUMENTOS
}

enum NivelAcesso {
  VISUALIZAR
  EDITAR
}

// "Sem acesso" nao e um nivel: e a ausencia da linha. Assim ninguem nasce com
// permissao e tirar acesso e apagar o registro.
model AcessoModulo {
  id        Int           @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo    ModuloSistema
  nivel     NivelAcesso
  createdAt DateTime      @default(now())

  @@unique([usuarioId, modulo])
  @@index([usuarioId])
}

// Classificacao de fornecimento (definida manualmente, base no trimestre anterior)
enum Classificacao {
  A
  B
  C
  D
}

enum EsforcoQualidade {
  BAIXO
  MEDIO
  ALTO
}

model Fornecedor {
  id     Int     @id @default(autoincrement())
  codigo String  @unique
  nome   String
  cnpj   String?

  // Dados complementares (opcionais no MVP)
  endereco String?

  // Escopo / classificacao (planilha "Escopo" + "Base de Fornecedores")
  tipoFornecimento    String? // ex: Paineis eletricos, Materia-prima, Parafusos
  categoriaInspecao   String? // ex: Eletrico/Montagem, Plastico injetado, Fixadores
  planoInspecao       String? // resumo textual do escopo
  controlesPrincipais String? // texto detalhado do que checar
  escopoTexto         String? // texto livre do escopo (aba Escopo)
  esforcoQualidade    EsforcoQualidade @default(MEDIO)

  // Classificacao de fornecimento (manual) - define periodicidade/nivel/NQA
  classificacaoFornecimento Classificacao @default(C)
  // Cadastro pontual (ex: importacao) feito na hora de uma inspecao extra.
  // Fica FORA do plano de periodicidade, mas os desvios contam nos indicadores.
  // Quando um dia for homologado, basta desmarcar - o cadastro ja existe.
  eventual                  Boolean       @default(false)
  // Escopo de inspeicao: quais formularios o sistema deve abrir
  fazVisual                 Boolean       @default(true)
  fazLote                   Boolean       @default(false)

  // Contadores
  contadorEntregas   Int @default(0) // ciclico: zera quando dispara inspecao
  totalEntregas      Int @default(0) // acumulado historico (dashboard)
  totalInspecoes     Int @default(0) // acumulado historico (dashboard)
  lotesInspecionados Int @default(0) // trimestre corrente
  lotesReprovados    Int @default(0) // trimestre corrente

  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  contatos         Contato[]
  itens            Item[]
  entregas         EntregaPortaria[]
  inspecoesVisual  InspecaoVisual[]
  inspecoesLote    InspecaoLote[]
  rncs             Rnc[]
  historicoClasses HistoricoClassificacao[]
  avaliacoes       AvaliacaoFornecedor[]
}

// Ate 2 contatos por fornecedor (cadastro simples)
model Contato {
  id           Int        @id @default(autoincrement())
  fornecedorId Int
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  nome         String
  email        String?
  telefone     String?
  funcao       String?

  @@index([fornecedorId])
}

model Item {
  id            Int         @id @default(autoincrement())
  codigo        String      @unique
  descricao     String
  unidade       String?
  // Custo unitario em R$ vindo da "Base de Codigos e Custo". E o valor que
  // alimenta valorUnitario da RNC e do CNQ quando o codigo e digitado. Fica
  // opcional porque item digitado na mao (fora da base) nao tem custo.
  custoUnitario Float?
  // Cadastro nao se apaga por padrao: inativa. Item inativo some das buscas
  // dos formularios, mas continua nos registros antigos que apontam para ele.
  ativo         Boolean     @default(true)
  fornecedorId  Int?
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  createdAt     DateTime    @default(now())

  entregas          EntregaPortaria[]
  inspecoesVisual   InspecaoVisual[]
  inspecoesLote     InspecaoLote[]
  rncs              Rnc[]
  controlesAutonomo ControleAutonomo[]
}

// Tabela de referencia de periodicidade por classificacao (pre-setada e editavel)
model PeriodicidadeConfig {
  id                 Int           @id @default(autoincrement())
  classificacao      Classificacao @unique
  periodicidadeTexto String // ex: "1 a cada 5 entregas"
  frequenciaN        Int // 5, 3, 1
  tipoInspecao       String        @default("Amostragem")
  nivelInspecaoTexto String // ex: "Inspecao Reduzida (30% itens)"
  nivelRomano        String // I, II, III
  percentualAmostra  Int // 30, 50, 100
  nqa                Float // 4.0, 2.5, 1.0
  // bandas de conformidade para reclassificacao
  conformidadeMin    Float // A>=98, B>=90, C>=80, D>=0
  updatedAt          DateTime      @updatedAt
}

// Anexo polimorfico: serve para qualquer entidade (Inspecao, RNC, modulos futuros)
model Anexo {
  id           Int      @id @default(autoincrement())
  entidadeTipo String // ex: "RNC", "INSPECAO_VISUAL", "INSPECAO_LOTE"
  entidadeId   Int
  nomeArquivo  String
  caminho      String
  mimeType     String?
  tamanho      Int?
  // Legenda da foto no PDF. Na foto de desvio da inspecao visual e o texto do
  // item do checklist que reprovou, para o relatorio dizer QUAL desvio a imagem
  // mostra. Nos demais anexos fica nulo e o bloco sai como sempre saiu.
  legenda      String?
  uploadedById Int?
  uploadedBy   Usuario? @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([entidadeTipo, entidadeId])
}

// Historico de status polimorfico: registra toda mudanca de status de qualquer entidade
model HistoricoStatus {
  id             Int      @id @default(autoincrement())
  entidadeTipo   String // ex: "RNC"
  entidadeId     Int
  statusAnterior String?
  statusNovo     String
  comentario     String?
  usuarioId      Int?
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt      DateTime @default(now())

  @@index([entidadeTipo, entidadeId])
}

// Historico de classificacao. Cada linha e o fechamento de uma competencia
// mensal do IDF (ver AvaliacaoFornecedor). Os registros antigos, de quando a
// classe era apurada por trimestre fiscal, continuam aqui e se distinguem pelo
// formato do rotulo.
model HistoricoClassificacao {
  id                   Int           @id @default(autoincrement())
  fornecedorId         Int
  fornecedor           Fornecedor    @relation(fields: [fornecedorId], references: [id])
  // Competencia da avaliacao: "2026-09". Registros legados: "FY26-Q3".
  trimestreFiscal      String
  periodoInicio        DateTime
  periodoFim           DateTime
  classificacaoInicial Classificacao // classe que o fornecedor tinha no periodo
  lotesInspecionados   Int
  lotesReprovados      Int
  pctConformidade      Float
  classificacaoApurada Classificacao // apurada pelo IDF (legados: por conformidade)
  createdAt            DateTime      @default(now())

  @@index([fornecedorId])
}

// Avaliacao mensal do fornecedor - IDF (Indice de Desempenho do Fornecedor).
//
// IDF = C1 x 50% + C2 x 30% + C3 x 20%, cada criterio virando nota de 0 a 10:
//   C1 - % de conformidade das inspecoes de recebimento
//   C2 - tempo de resposta das RNCs
//   C3 - nivel do plano de acao das RNCs
// A classe que sai do IDF substitui a antiga classe por conformidade e e ela
// que comanda a periodicidade de inspecao.
//
// A competencia NAO e o mes civil: fecha no dia 26, como folha de pagamento.
// A avaliacao e registro proprio - le os dados da RNC e das inspecoes, mas nao
// fica presa a eles. Depois de fechada, nada mais a reescreve.
model AvaliacaoFornecedor {
  id            Int        @id @default(autoincrement())
  fornecedorId  Int
  fornecedor    Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  ano           Int
  mes           Int // 1-12
  periodoInicio DateTime // dia 27 do mes anterior
  periodoFim    DateTime // dia 26 da competencia

  // C1 - conformidade do recebimento
  lotesInspecionados Int    @default(0)
  lotesReprovados    Int    @default(0)
  pctConformidade    Float  @default(0)
  notaC1Auto         Float?

  // C2 - tempo de resposta da RNC
  rncsConsideradas   Int    @default(0)
  horasRespostaMedia Float?
  notaC2Auto         Float?

  // C3 - nivel do plano de acao
  notaC3Auto Float?

  // Nota digitada a mao. Sobrepoe a automatica: existe criterio externo que o
  // sistema nao enxerga e que a Qualidade precisa poder registrar.
  notaC1Manual Float?
  notaC2Manual Float?
  notaC3Manual Float?
  justificativa String?

  idf           Float?
  classificacao Classificacao?

  // Fechada congela os numeros e aplica a classe no fornecedor.
  fechada   Boolean   @default(false)
  fechadaEm DateTime?

  atualizadoPorId Int?
  atualizadoPor   Usuario?  @relation("AvaliacaoFornecedorPor", fields: [atualizadoPorId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([fornecedorId, ano, mes])
  @@index([ano, mes])
}

// ---------------------- MODULO SQE ----------------------

// Um recebimento. Quando ele e inspecionado, ganha um numero de inspecao
// (INSP0001/2026) e passa a ser a UNIDADE de inspecao: os formularios Visual e
// Lote do mesmo recebimento sao a MESMA inspecao, contam como uma so e
// compartilham uma unica RNC.
model EntregaPortaria {
  id                     Int        @id @default(autoincrement())
  fornecedorId           Int
  fornecedor             Fornecedor @relation(fields: [fornecedorId], references: [id])
  itemId                 Int?
  item                   Item?      @relation(fields: [itemId], references: [id])
  dataEntrega            DateTime   @default(now())
  semanaReferencia       String? // W do recebimento (domingo->sabado)
  semana                 String? // semana no formato W## (ex: W28)
  ano                    Int? // ano do recebimento
  notaFiscal             String?
  po                     String?
  quantidade             Float?
  // Decisao automatica de inspecao
  numeroEntregaAcumulado Int? // valor do contador no momento
  passivelInspecao       Boolean    @default(false) // sistema decidiu inspecionar?

  // Identificacao da inspecao (nula enquanto o recebimento nao for inspecionado)
  numeroInspecao     String? @unique // formato INSP0001/2026
  inspecaoAno        Int? // ano da inspecao (sequencial reinicia por ano)
  inspecaoSequencial Int? // sequencial dentro do ano
  // Inspecao fora do ciclo de periodicidade: fornecedor eventual OU fornecedor
  // da base inspecionado dentro da janela em que o sistema nao sugeriria.
  inspecaoExtra      Boolean @default(false)

  confirmadoPorId Int?
  confirmadoPor   Usuario? @relation("EntregaConfirmadoPor", fields: [confirmadoPorId], references: [id])
  createdAt       DateTime @default(now())

  inspecoesVisual InspecaoVisual[]
  inspecoesLote   InspecaoLote[]
  rncs            Rnc[]

  @@unique([inspecaoAno, inspecaoSequencial])
}

enum ResultadoInspecao {
  APROVADO
  REPROVADO
}

enum OrigemInspecao {
  PLANO_INSPECAO
  HOMOLOGACAO
  DEVOLUCAO
  RETRABALHO
  RELATORIO_OCORRENCIA
  LIBERACAO_SETUP
  // So aparece na Manufatura: e a inspecao feita durante a producao.
  INSPECAO_PRODUCAO
  OUTROS
}

// Formulario VISUAL - Doc BDBR.QUA.FMR.06.07
// Checklist de 12 grupos armazenado em JSON (fiel a planilha)
model InspecaoVisual {
  id           Int              @id @default(autoincrement())
  entregaId    Int?
  entrega      EntregaPortaria? @relation(fields: [entregaId], references: [id])
  fornecedorId Int
  fornecedor   Fornecedor       @relation(fields: [fornecedorId], references: [id])
  itemId       Int
  item         Item             @relation(fields: [itemId], references: [id])

  // Cabecalho comum
  // desenhoRev e o campo antigo (desenho e revisao juntos). Ficou para nao
  // mexer nos registros ja gravados; o que se preenche hoje sao os dois
  // campos separados abaixo.
  desenhoRev      String?
  desenho         String?
  revisao         String?
  toleranciasNorm String?
  notaFiscal      String?
  po              String?
  qtdInspecionada Float?
  qtdTotal        Float?
  relatorioNumero String?
  origem          OrigemInspecao @default(PLANO_INSPECAO)
  origemOutros    String? // texto do campo "Outros:"

  // Checklist (12 grupos) - JSON: [{ grupo, itens: [{ texto, status }] }]
  checklist Json

  observacoes String?
  resultado   ResultadoInspecao @default(APROVADO)

  // Inspecao salva pela metade, para terminar depois. Enquanto e rascunho ela
  // NAO conta em lugar nenhum: nao soma nos contadores do fornecedor, nao zera
  // o ciclo de periodicidade, nao abre RNC e fica de fora dos indicadores. O
  // numero do recebimento ja e consumido na hora de salvar, para o documento
  // nascer com a identificacao que vai levar ate o fim.
  rascunho Boolean @default(false)

  // Abrir RNC e decisao do inspetor. Quando ele diz NAO, a inspecao encerra
  // APROVADA e os itens reprovados continuam marcados no checklist - o que
  // muda e o veredito do recebimento, nao o que foi observado. A justificativa
  // e obrigatoria e sai impressa no relatorio, senao o documento nao se
  // explica sozinho.
  desvioSemRnc     Boolean @default(false)
  observacaoDesvio String?

  dataInspecao DateTime @default(now())
  semana       String? // semana da inspecao no formato W## (ex: W28)
  ano          Int? // ano da inspecao
  inspetorId   Int?
  inspetor     Usuario? @relation("InspVisualInspetor", fields: [inspetorId], references: [id])
  createdAt    DateTime @default(now())

  rncs Rnc[]
}

// Formulario LOTE / DIMENSIONAL - Doc BDBR.QUA.FMR.011.06
model InspecaoLote {
  id           Int              @id @default(autoincrement())
  entregaId    Int?
  entrega      EntregaPortaria? @relation(fields: [entregaId], references: [id])
  fornecedorId Int
  fornecedor   Fornecedor       @relation(fields: [fornecedorId], references: [id])
  itemId       Int
  item         Item             @relation(fields: [itemId], references: [id])

  // Cabecalho comum
  // Ver InspecaoVisual: desenhoRev e o campo legado, desenho/revisao sao os
  // campos que valem hoje.
  desenhoRev      String?
  desenho         String?
  revisao         String?
  // Peca de conjunto: desenhos EXTRAS, do 2o em diante ([{ desenho, revisao }]).
  // O 1o continua nos campos acima e cada cota diz a qual desenho pertence pelo
  // "desenhoIdx". Ver comum/inspecao.ts (gruposDeDesenho).
  desenhos        Json?
  toleranciasNorm String?
  notaFiscal      String?
  po              String?
  qtdInspecionada Float?
  qtdTotal        Float?
  relatorioNumero String?
  origem          OrigemInspecao @default(PLANO_INSPECAO)
  origemOutros    String? // texto do campo "Outros:"

  // Tabela de cotas, no padrao comum aos tres modulos:
  // [{ localizacao, especificado, unidade, norma, tolerancia, upper, lower,
  //    encontradoMax, encontradoMin, instrumento, desvioMin, desvioMax,
  //    conformeAuto, conformeManual, conforme }]
  cotas Json

  observacoes String?
  resultado   ResultadoInspecao @default(APROVADO)

  // Ver InspecaoVisual: rascunho e a inspecao salva pela metade, fora de todos
  // os contadores e indicadores ate ser lancada.
  rascunho Boolean @default(false)

  // Abrir RNC e decisao do inspetor. Quando ele diz NAO, a inspecao encerra
  // APROVADA e as cotas reprovadas continuam marcadas na tabela - o que muda e
  // o veredito do recebimento, nao o que foi medido. A justificativa e
  // obrigatoria e sai impressa no relatorio, senao o documento nao se explica
  // sozinho.
  desvioSemRnc     Boolean @default(false)
  observacaoDesvio String?

  dataInspecao DateTime @default(now())
  semana       String? // semana da inspecao no formato W## (ex: W28)
  ano          Int? // ano da inspecao
  inspetorId   Int?
  inspetor     Usuario? @relation("InspLoteInspetor", fields: [inspetorId], references: [id])
  createdAt    DateTime @default(now())

  rncs Rnc[]
}

// RNC - Doc BDBR.QUA.FMR.003.03 (controle interno)
enum StatusRnc {
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

enum VerificacaoEficacia {
  PENDENTE
  APROVADO
  REPROVADO
  NAO_APLICAVEL
}

enum NivelPlano {
  RUIM
  SATISFATORIO
  EXCELENTE
  NAO_APLICAVEL
}

model Rnc {
  id         Int    @id @default(autoincrement())
  numero     String @unique // formato RNC0001/2026
  ano        Int // ano da RNC (para gerar sequencial por ano)
  sequencial Int // sequencial dentro do ano

  // origem (inspecao reprovada). A entrega e a inspecao a que a RNC pertence:
  // e por ela que se garante UMA RNC por inspecao, mesmo quando Visual e Lote
  // sao reprovados. Os dois campos abaixo dizem QUAL formulario reprovou.
  entregaId        Int?
  entrega          EntregaPortaria? @relation(fields: [entregaId], references: [id])
  inspecaoVisualId Int?
  inspecaoVisual   InspecaoVisual?  @relation(fields: [inspecaoVisualId], references: [id])
  inspecaoLoteId   Int?
  inspecaoLote     InspecaoLote?    @relation(fields: [inspecaoLoteId], references: [id])

  // Informacoes do documento
  dataAbertura DateTime @default(now())
  semana       String? // semana da abertura no formato W## (ex: W28)
  solicitante  String   @default("Qualidade")

  // Informacoes do item
  itemId         Int
  item           Item    @relation(fields: [itemId], references: [id])
  quantidadeLote Float?
  po             String?
  notaFiscal     String?

  // Informacoes do fornecedor
  fornecedorId Int
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])

  // Informacoes sobre o desvio
  tipoDesvio      String // texto livre
  reincidencia    Boolean @default(false)
  descricaoDesvio String

  // Custos RNC
  quantidadePecas Float?
  valorUnitario   Float?
  valorTotal      Float? // = quantidadePecas * valorUnitario

  // Envio do documento ao fornecedor. E o que fecha o lead time INTERNO da
  // Qualidade: da abertura da RNC ate o dia em que o documento saiu para o
  // fornecedor. A data e informada pelo usuario (retroativa e permitida) e o
  // tempo em dias e calculado na leitura, nunca gravado.
  enviadaFornecedor   Boolean   @default(false)
  dataEnvioFornecedor DateTime?

  // Plano de acao
  disposicao            String? // texto livre
  houveRetorno          Boolean?
  dataRetorno           DateTime?
  tempoRetornoDias      Int? // = dataRetorno - dataAbertura
  fornecedorAceitou     String? // "Sim" / "Nao (Ver observacoes)"
  fornecedorEnviouPlano Boolean?
  nivelPlano            NivelPlano?
  status                StatusRnc           @default(EM_ANDAMENTO)
  motivoCancelamento    String? // motivo quando status = CANCELADA
  // Dois pares independentes: encerrar a RNC e verificar a eficacia sao atos
  // diferentes. As duas datas sao informadas pelo usuario (retroativas sao
  // permitidas) e nunca carimbadas automaticamente com o "agora".
  dataEncerramento      DateTime? // preenchida quando status = FINALIZADA
  verificacaoEficacia   VerificacaoEficacia @default(PENDENTE)
  dataVerificacao       DateTime? // so existe quando a eficacia saiu de PENDENTE

  // Desvio de qualidade: libera o item por um limite acordado - uma
  // quantidade de pecas, um prazo, ou os dois (ao menos um e obrigatorio).
  // O documento que autoriza o desvio e obrigatorio e vive na tabela Anexo,
  // com entidadeTipo "RNC_DESVIO".
  desvioQualidade       Boolean   @default(false)
  desvioAberturaEm      DateTime?
  desvioQuantidade      Float?
  desvioPrazoFim        DateTime?
  desvioDescricao       String?
  desvioEncerradoEm     DateTime?
  desvioEncerramentoObs String?

  evidencias  String?
  observacoes String?

  criadoPorId Int?
  criadoPor   Usuario? @relation("RncCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([ano, sequencial])
}

// ---------------------- MODULO MANUFATURA ----------------------

// A planilha de indicadores cobre duas areas com naturezas diferentes:
// FABRICACAO trabalha por maquina (Prensa 100, Laser...) e MONTAGEM por linha
// (Linha 1, Linha 2...). As duas sao inspecionadas pelos mesmos formularios,
// entao ficam no mesmo cadastro, separadas pelo campo area.
enum AreaManufatura {
  FABRICACAO
  MONTAGEM
}

model Maquina {
  id     Int            @id @default(autoincrement())
  codigo String         @unique
  nome   String
  area   AreaManufatura @default(FABRICACAO)

  // Acumulados do trimestre corrente (zerados no fechamento)
  setupsRealizados    Int @default(0)
  producoesRealizadas Int @default(0)
  inspecoesReprovadas Int @default(0)

  descricao String?
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  producaoDiaria    ProducaoDiaria[]
  inspecoes         InspecaoManufatura[]
  inspecoesVisual   InspecaoVisualManufatura[]
  cnqs              Cnq[]
  historico         HistoricoMaquina[]
  alertas           AlertaQualidade[]
  controlesAutonomo ControleAutonomo[]
}

// Apontamento diario que os operadores entregam em papel e a Qualidade digita.
// E a base do PPM: (qtdDefeito / qtdProduzida) * 1.000.000.
model ProducaoDiaria {
  id           Int      @id @default(autoincrement())
  maquinaId    Int
  maquina      Maquina  @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  data         DateTime @db.Date
  qtdProduzida Float    @default(0)
  qtdDefeito   Float    @default(0)

  registradoPorId Int?
  registradoPor   Usuario? @relation("ProducaoRegistradaPor", fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([maquinaId, data])
  @@index([data])
}

// Lista oficial de "Descricao do Defeito" (aba Defeitos e CNQ). Cadastravel
// para a Qualidade ajustar sem depender de deploy.
model TipoDefeito {
  id           Int     @id @default(autoincrement())
  nome         String  @unique
  ordem        Int     @default(0)
  ativo        Boolean @default(true)
  // "Outros": o lancamento tem de dizer qual foi o defeito. Marcado por flag e
  // nao pelo nome, senao renomear a linha no cadastro apagaria o campo aberto.
  exigeDetalhe Boolean @default(false)

  cnqs Cnq[]
}

enum TipoInspecaoManufatura {
  SETUP
  PRODUCAO
}

// Resultado dos formularios da manufatura. Diferente do SQE, existe o
// "aprovado com observacao": o item passa, mas com ressalva registrada.
// Para os indicadores ele conta como aprovado.
enum ResultadoManufatura {
  APROVADO
  APROVADO_COM_OBSERVACAO
  REPROVADO
}

enum StatusInspecaoManufatura {
  PENDENTE
  APROVADA
  APROVADA_COM_OBSERVACAO
  REPROVADA
}

// A inspecao-mae. Reprovar NAO encerra: a inspecao fica PENDENTE e recebe um
// novo RelatorioDimensional (tentativa 2, 3...) ate aprovar. Todas as
// tentativas ficam guardadas aqui e saem juntas no PDF.
model InspecaoManufatura {
  id     Int                    @id @default(autoincrement())
  tipo   TipoInspecaoManufatura
  numero String                 @unique // SET0001/2026 ou PROD0001/2026 (numero da 1a tentativa)

  maquinaId Int
  maquina   Maquina @relation(fields: [maquinaId], references: [id])

  // Item digitado livre (a base interna de itens entra depois)
  itemCodigo    String?
  itemDescricao String?
  po            String?

  // Inspecao de producao pode referenciar o setup que a antecedeu (opcional,
  // so como rastreabilidade - nao altera status nem indicador).
  setupId   Int?
  setup     InspecaoManufatura?  @relation("ProducaoDoSetup", fields: [setupId], references: [id])
  producoes InspecaoManufatura[] @relation("ProducaoDoSetup")

  status       StatusInspecaoManufatura @default(PENDENTE)
  dataInspecao DateTime                 @default(now())
  semana       String?
  ano          Int?

  inspetorId Int?
  inspetor   Usuario? @relation("InspManufaturaInspetor", fields: [inspetorId], references: [id])
  createdAt  DateTime @default(now())

  relatorios RelatorioDimensional[]
  oitoDs     OitoD[]
  cincoGs    CincoG[]

  @@index([tipo, dataInspecao])
}

// RELATORIO DE INSPECAO DIMENSIONAL - Doc BDBR.QUA.FMR.011.06 (rev. 06).
// Espelha o formulario campo a campo. Cada tentativa e um relatorio completo,
// com numero proprio tirado da mesma serie da inspecao.
model RelatorioDimensional {
  id         Int                @id @default(autoincrement())
  inspecaoId Int
  inspecao   InspecaoManufatura @relation(fields: [inspecaoId], references: [id], onDelete: Cascade)

  // tipo repetido aqui (e nao so na inspecao-mae) para que a numeracao
  // SET/PROD possa ter unicidade garantida pelo banco.
  tipo       TipoInspecaoManufatura
  numero     String                 @unique
  ano        Int
  sequencial Int
  tentativa  Int                    @default(1)

  // "Rev." do proprio relatorio, preenchido a mao (comeca em 01)
  revisao String @default("01")

  dataInspecao DateTime       @default(now())
  origem       OrigemInspecao @default(LIBERACAO_SETUP)
  origemOutros String? // texto do campo "Outros:"

  itemCodigo      String?
  itemDescricao   String?
  // desenhoRev e o campo legado (desenho e revisao juntos). O que se preenche
  // hoje sao os dois campos separados. Aqui a revisao do desenho se chama
  // desenhoRevisao porque "revisao" ja e a revisao do proprio relatorio.
  desenhoRev      String?
  desenho         String?
  desenhoRevisao  String?
  // Peca de conjunto: desenhos EXTRAS, do 2o em diante ([{ desenho, revisao }]).
  // O 1o continua nos campos acima e cada cota diz a qual desenho pertence pelo
  // "desenhoIdx". Ver comum/inspecao.ts (gruposDeDesenho).
  desenhos        Json?
  // Norma de tolerancia do relatorio: ISO2768 | DIN7168 | NA
  toleranciasNorm String?
  po              String?
  qtdInspecionada Float?
  qtdTotal        Float?

  // Cotas do formulario, no padrao comum aos tres modulos:
  // [{ localizacao, especificado, unidade, norma, tolerancia, upper, lower,
  //    encontradoMax, encontradoMin, instrumento, desvioMin, desvioMax,
  //    conformeAuto, conformeManual, conforme }]
  cotas Json

  // INSPECAO VISUAL - opcional no setup e na producao. Campo aberto: o
  // inspetor descreve o que observou. As fotos vao no bloco de evidencias do
  // visual (EVID.manufaturaVisual), que ja existe.
  inspecaoVisual String?

  observacoesFinais   String?
  resultado           ResultadoManufatura @default(APROVADO)
  // Texto obrigatorio quando o resultado e APROVADO_COM_OBSERVACAO
  observacaoResultado String?

  // Bloco de desvio (aparece quando ha ressalva ou reprova):
  // defeitos e um array com os nomes da lista oficial de tipos de defeito.
  defeitos        Json?
  qtdAfetada      Float?
  descricaoDesvio String?

  elaboradoPor    String?
  inspecionadoPor String?
  inspetorId      Int?
  inspetor        Usuario? @relation("RelatorioInspetor", fields: [inspetorId], references: [id])
  createdAt       DateTime @default(now())

  // Ver InspecaoVisual: relatorio salvo pela metade. Fora do PPM, da taxa de
  // aprovacao e dos contadores da maquina ate ser lancado.
  rascunho Boolean @default(false)

  @@unique([tipo, ano, sequencial])
  @@index([inspecaoId])
}

// INSPECAO VISUAL DA MANUFATURA - documento proprio, separado do dimensional.
// Antes o visual era um campo opcional dentro do RelatorioDimensional; virou
// registro proprio porque a inspecao visual acontece sozinha, sem medicao.
//
// Nao tem cotas nem tentativas: e um registro do que o inspetor observou
// naquele momento, com o mesmo cabecalho do formulario dimensional. As fotos
// vao na tabela polimorfica Anexo (EVID.manufaturaVisualInspecao).
model InspecaoVisualManufatura {
  id         Int                    @id @default(autoincrement())
  tipo       TipoInspecaoManufatura
  // Serie propria, separada da do dimensional: SETV0001/2026, PRODV0001/2026.
  numero     String                 @unique
  ano        Int
  sequencial Int

  maquinaId Int
  maquina   Maquina @relation(fields: [maquinaId], references: [id])

  // "Rev." do proprio relatorio, preenchido a mao (comeca em 01)
  revisao      String         @default("01")
  dataInspecao DateTime       @default(now())
  semana       String?
  origem       OrigemInspecao @default(LIBERACAO_SETUP)
  origemOutros String?

  itemCodigo      String?
  itemDescricao   String?
  desenho         String?
  desenhoRevisao  String?
  po              String?
  qtdInspecionada Float?
  qtdTotal        Float?

  // Campo aberto: o inspetor descreve o que observou.
  observacoes String?

  elaboradoPor    String?
  inspecionadoPor String?
  inspetorId      Int?
  inspetor        Usuario? @relation("InspVisualManufaturaInspetor", fields: [inspetorId], references: [id])
  createdAt       DateTime @default(now())

  // Ver InspecaoVisual: inspecao salva pela metade, fora dos indicadores ate
  // ser lancada.
  rascunho Boolean @default(false)

  @@unique([tipo, ano, sequencial])
  @@index([tipo, dataInspecao])
}

// CNQ - Custo da Nao Qualidade. Espelha a aba "Defeitos e CNQ": um lancamento
// por apontamento de operador. Independente das inspecoes.
model Cnq {
  id         Int    @id @default(autoincrement())
  numero     String @unique // CNQ0001/2026
  ano        Int
  sequencial Int

  data      DateTime @db.Date
  maquinaId Int
  maquina   Maquina  @relation(fields: [maquinaId], references: [id])

  itemCodigo    String
  itemDescricao String?

  tipoDefeitoId Int
  tipoDefeito   TipoDefeito @relation(fields: [tipoDefeitoId], references: [id])
  // Defeito digitado quando o tipo escolhido e "Outros". Aparece junto do nome
  // no relatorio, mas o Pareto continua somando tudo como "Outros".
  defeitoOutros String?

  quantidade    Float
  // Valor da peca digitado no lancamento (nao ha base de precos ainda)
  valorUnitario Float @default(0)
  valorTotal    Float @default(0) // = quantidade * valorUnitario

  observacoes String?
  acao        String?

  criadoPorId Int?
  criadoPor   Usuario? @relation("CnqCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  oitoDs  OitoD[]
  cincoGs CincoG[]

  @@unique([ano, sequencial])
  @@index([data])
}

// FORMULARIO 8D - Doc BDBR.QUA.FMR.007.01 (rev. 1)
enum StatusOitoD {
  AGUARDANDO
  EM_ANDAMENTO
  CONCLUIDO
}

enum OrigemOitoD {
  RELATORIO_RO
  PRODUCAO
  INSPECAO_EXTRA
  SETUP
  // RNC e so o motivo da abertura: nao ha vinculo com a RNC do SQE. O numero
  // dela, quando houver, vai no campo "documento referenciado".
  RNC
  OUTROS
}

enum TurnoManufatura {
  COMERCIAL
  SEGUNDO_TURNO
}

model OitoD {
  id         Int    @id @default(autoincrement())
  numero     String @unique // 8D0001/2026
  ano        Int
  sequencial Int

  // Opcional: nasce de uma inspecao com desvio OU de um lancamento de CNQ
  inspecaoId Int?
  inspecao   InspecaoManufatura? @relation(fields: [inspecaoId], references: [id])
  cnqId      Int?
  cnq        Cnq?                @relation(fields: [cnqId], references: [id])

  // Cabecalho
  empresaUnidade      String          @default("Big Dutchman Brasil")
  dataAbertura        DateTime        @default(now())
  status              StatusOitoD     @default(AGUARDANDO)
  produtoItem         String?
  codigoDesenho       String?
  origem              OrigemOitoD     @default(PRODUCAO)
  // Origem digitada quando "origem" e OUTROS
  origemOutros        String?
  // Documento que motivou a abertura (RNC, relatorio, e-mail...): o numero e
  // digitado aqui e o arquivo entra como anexo OITO_D_DOC.
  documentoReferencia String?
  local               String?
  processoOperacao    String?
  equipamento         String?
  turno               TurnoManufatura @default(COMERCIAL)
  qtdAfetada          String?
  // "responsavel" e o Coordenador e "equipe" e o Grupo de Trabalho da planilha.
  responsavel         String?
  equipe              String?
  departamento        String?
  areaAplicacao       String?
  // Passo 1 - Problema (o enunciado)
  descricaoProblema   String?

  // Passo 1.1 - Objetivos (SMART, medidos contra a perda causal)
  objetivos     String?
  perdaAtacada  String?
  perdaValorAno Float?

  // Passo 1.2 - Descricao do problema (5W 1H)
  // { oQue, quando, onde, quem, qual, como }
  descricao5W1H Json?

  // Passo 1.3 e 1.4 (as imagens vao como anexo)
  situacaoAtual  String?
  estratificacao String?

  // HISTORICO: o Metodo 5G e o cronograma sairam do 8D quando o 5G virou
  // documento proprio (model CincoG). As colunas continuam no banco para nao
  // perder o que ja foi gravado, mas nao sao mais preenchidas pela tela.
  metodo5G   Json?
  cronograma Json?

  // Passo 2 - Analise de causa raiz (6M + 1D)
  efeito           String?
  // Espinha de peixe: { medicao, maquina, meioAmbiente, metodo, material, maoDeObra, projeto }
  causas6M         Json?
  // Matriz Causas Potenciais x Porque 1..5
  // [{ causa, porque1, porque2, porque3, porque4, porque5 }]
  causasPotenciais Json?
  // 5 Porques do formulario antigo (mantido para nao perder registro ja gravado)
  porques          Json?

  // Causa raiz confirmada
  causaRaiz String?

  // Passo 3 - Plano de acao
  // [{ oQue, porQue, como, quem, quando, custo, situacao }]
  planoAcao Json?

  // Padronizacao (documentos e treinamentos decorrentes do plano)
  // { documentos, treinamentos, observacoes }
  padronizacao Json?

  // Passo 4 - Verificacao dos resultados (monitorar por pelo menos 3 meses)
  verificacaoResultados String?
  // Bloco estruturado de eficacia do formulario antigo
  // { criterio, metodo, amostra, resultadoEsperado, resultadoObtido, data, responsavel, eficaz }
  verificacaoEficacia   Json?

  // Conclusao / Fechamento
  dataTermino         DateTime?
  custosInvestimentos String?
  beneficiosGanhos    String?
  resultadosIndices   String?
  verificacaoGerente  String?

  // Aprovacoes: so a Qualidade aprova no sistema (com registro de quem e
  // quando). O campo da Producao continua no PDF, identico ao papel.
  aprovadoPorId     Int?
  aprovadoPor       Usuario?  @relation("OitoDAprovadoPor", fields: [aprovadoPorId], references: [id])
  aprovadoEm        DateTime?
  aprovacaoProducao String?

  criadoPorId Int?
  criadoPor   Usuario? @relation("OitoDCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([ano, sequencial])
}

// METODO 5G - espelha a aba "MÉTODO 5G" da planilha "Analise de Problemas da
// Qualidade - Padrao". E um documento proprio, numerado 5G0001/2026: nem todo
// problema vira 8D, muitos sao resolvidos so com a ida ao posto de trabalho.
// O corpo e o checklist fixo das 9 avaliacoes - o inspetor nao cria nem apaga
// linha, so preenche as colunas de cada avaliacao, como no papel.
model CincoG {
  id         Int    @id @default(autoincrement())
  numero     String @unique // 5G0001/2026
  ano        Int
  sequencial Int

  // Opcional: nasce de uma inspecao com desvio OU de um lancamento de CNQ
  inspecaoId Int?
  inspecao   InspecaoManufatura? @relation(fields: [inspecaoId], references: [id])
  cnqId      Int?
  cnq        Cnq?                @relation(fields: [cnqId], references: [id])

  // Cabecalho (mesmos campos do 8D, para o documento ser reconhecivel)
  dataAbertura        DateTime        @default(now())
  status              StatusOitoD     @default(AGUARDANDO)
  origem              OrigemOitoD     @default(PRODUCAO)
  // Mesmo par do 8D: origem digitada quando e OUTROS e o documento que motivou
  // a abertura (numero aqui, arquivo no anexo CINCO_G_DOC).
  origemOutros        String?
  documentoReferencia String?
  turno               TurnoManufatura @default(COMERCIAL)
  produtoItem         String?
  codigoDesenho       String?
  local               String?
  processoOperacao    String?
  equipamento         String?
  responsavel         String?
  equipe              String?
  departamento        String?
  areaAplicacao       String?

  descricaoProblema String?

  // Checklist das 9 avaliacoes da aba "MÉTODO 5G"
  // [{ avaliacao, analise4M, objetivo, especificado, verificado, necessitaRestauracao,
  //    comoRestaurar, responsavel, prazo, status, eficaz }]
  avaliacoes Json?

  // Fechamento
  conclusao          String?
  dataTermino        DateTime?
  verificacaoGerente String?

  aprovadoPorId Int?
  aprovadoPor   Usuario?  @relation("CincoGAprovadoPor", fields: [aprovadoPorId], references: [id])
  aprovadoEm    DateTime?

  criadoPorId Int?
  criadoPor   Usuario? @relation("CincoGCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([ano, sequencial])
  @@index([dataAbertura])
}

// ALERTA DA QUALIDADE - espelha o .docx "Alerta da Qualidade - Rebarba
// (Puncionadeiras)": tarja com titulo e data, "Descricao do problema", o texto
// da acao obrigatoria e dois paineis de foto (ERRADO / CERTO), com
// "Elaborado por" no rodape.
//
// ABERTO e RENOVADO sao as duas situacoes em que o alerta ainda esta valendo.
// VENCIDO nao e status gravado: e calculado (prazo passado com o alerta ainda
// em aberto), justamente para que um alerta encerrado fora do prazo nao fique
// marcado como vencido para sempre.
enum StatusAlertaQualidade {
  ABERTO
  RENOVADO
  ENCERRADO
}

model AlertaQualidade {
  id         Int    @id @default(autoincrement())
  numero     String @unique // ALQ0001/2026
  ano        Int
  sequencial Int

  data   DateTime @db.Date // data que sai ao lado do titulo do alerta
  titulo String // "Descricao do problema" (ex: REBARBA NAS PECAS)
  acao   String // texto da acao obrigatoria, no corpo do alerta

  // Onde o alerta se aplica. A maquina e opcional porque o alerta costuma
  // valer para um grupo inteiro ("Puncionadeiras").
  setor     String?
  maquinaId Int?
  maquina   Maquina? @relation(fields: [maquinaId], references: [id])

  // Legendas opcionais dos dois paineis de foto.
  legendaErrado String?
  legendaCerto  String?

  prazo  DateTime              @db.Date // prazo para corrigir
  status StatusAlertaQualidade @default(ABERTO)

  elaboradoPor String?

  dataEncerramento       DateTime? @db.Date
  observacaoEncerramento String?
  encerradoPorId         Int?
  encerradoPor           Usuario?  @relation("AlertaEncerradoPor", fields: [encerradoPorId], references: [id])

  criadoPorId Int?
  criadoPor   Usuario? @relation("AlertaCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  renovacoes RenovacaoAlerta[]

  @@unique([ano, sequencial])
  @@index([data])
}

// Historico das prorrogacoes: cada renovacao guarda o prazo que venceu e o
// novo, para o alerta nunca perder a data original.
model RenovacaoAlerta {
  id       Int             @id @default(autoincrement())
  alertaId Int
  alerta   AlertaQualidade @relation(fields: [alertaId], references: [id], onDelete: Cascade)

  prazoAnterior DateTime @db.Date
  prazoNovo     DateTime @db.Date
  motivo        String?

  criadoPorId Int?
  criadoPor   Usuario? @relation("RenovacaoAlertaCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([alertaId])
}

// ICAQ - Auditoria do Controle Autonomo da Qualidade.
// Espelha o "Checklist ICAQ": 10 verificacoes distribuidas em 4 dimensoes
// ponderadas. A auditoria e lancada e fechada de uma vez - nao ha rascunho.

// Este formulario e o unico da manufatura que trabalha com os tres turnos de
// producao; os demais so conhecem Comercial e 2o turno.
enum TurnoIcaq {
  PRIMEIRO_TURNO
  SEGUNDO_TURNO
  TERCEIRO_TURNO
  COMERCIAL
}

// A planilha nao preve "nao aplicavel": ou o requisito foi atendido, ou nao.
enum ResultadoIcaq {
  CONFORME
  NAO_CONFORME
}

enum ClassificacaoIcaq {
  CONFORME // 90% a 100%
  ATENCAO // 80% a 89,99%
  NAO_CONFORME // abaixo de 80%
}

model ControleAutonomo {
  id         Int    @id @default(autoincrement())
  numero     String @unique // ICAQ0001/2026
  ano        Int
  sequencial Int

  dataAuditoria DateTime  @db.Date
  turno         TurnoIcaq @default(COMERCIAL)

  maquinaId Int
  maquina   Maquina @relation(fields: [maquinaId], references: [id])

  // O item da lista preenche Produto e Codigo de uma vez.
  itemId Int?
  item   Item? @relation(fields: [itemId], references: [id])

  ordemLote String?
  // Operador auditado e digitado: quem esta na maquina nem sempre tem cadastro.
  operador  String

  auditorId Int
  auditor   Usuario @relation("IcaqAuditor", fields: [auditorId], references: [id])

  observacoesIniciais String?

  // Nota de 0 a 100 e classificacao, gravadas no fechamento para o painel nao
  // ter de recalcular linha a linha.
  nota          Float             @default(0)
  classificacao ClassificacaoIcaq @default(NAO_CONFORME)

  itens ItemControleAutonomo[]

  criadoPorId Int?
  criadoPor   Usuario? @relation("IcaqCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ano, sequencial])
  @@index([dataAuditoria])
}

// Uma linha do checklist. A dimensao, o peso e o texto da verificacao vivem no
// codigo (icaq-utils.ts) e sao copiados para ca no lancamento, para que uma
// revisao futura do formulario nao mude a nota de auditoria ja realizada.
model ItemControleAutonomo {
  id         Int              @id @default(autoincrement())
  controleId Int
  controle   ControleAutonomo @relation(fields: [controleId], references: [id], onDelete: Cascade)

  numero      Int // 1 a 10
  dimensao    String
  peso        Float
  verificacao String

  resultado ResultadoIcaq
  // Peso da dimensao dividido pelo numero de perguntas dela, e so quando
  // Conforme. A soma dos dez pontos fecha em 1,00.
  pontos    Float         @default(0)

  evidencia   String?
  responsavel String?

  @@unique([controleId, numero])
}

// Snapshot do trimestre fiscal por maquina: o fechamento congela os numeros
// do periodo e zera os contadores.
model HistoricoMaquina {
  id        Int     @id @default(autoincrement())
  maquinaId Int
  maquina   Maquina @relation(fields: [maquinaId], references: [id])

  trimestreFiscal String
  periodoInicio   DateTime
  periodoFim      DateTime

  pecasProduzidas     Float
  pecasComDefeito     Float
  ppm                 Float
  cnqTotal            Float
  setupsRealizados    Int
  producoesRealizadas Int
  inspecoesReprovadas Int

  createdAt DateTime @default(now())

  @@index([maquinaId])
}

// ---------------------- MODULO SQD ----------------------
// Homologacao de fornecedores: a autoavaliacao (self audit) do documento
// BDBR.QUA.FMR.024.03 e o controle do BDBR.QUA.FMR.029.01 sao o MESMO
// registro, aberto pelo mesmo numero (HFOR0001/2026).
//
// O registro nasce sem avaliacao: a Qualidade abre com os dados do fornecedor
// e a data da solicitacao (a mesma em que o formulario segue para o
// fornecedor) e fica aguardando o retorno. So quando o fornecedor responde a
// autoavaliacao e lancada e passam a existir nota e resultado.

enum ResultadoHomologacao {
  APROVADO
  APROVADO_CONDICIONALMENTE
  REPROVADO
}

enum StatusHomologacao {
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
}

enum StatusPlanoAcaoSqd {
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
  NAO_APLICAVEL
}

// Criterios de efetividade descritos na aba "Base de Dados" do FMR.029.01
enum EfetividadePlanoAcao {
  NAO_APLICAVEL_CANCELADO
  NAO_IMPLEMENTADO_ATRASADO
  EFETIVO
  PARCIALMENTE_EFETIVO
  INEFICAZ
}

enum SolicitanteSqd {
  COMPRAS
  ENGENHARIA
  NC
  FORNECEDOR // so aparece na homologacao de itens (FMR.025.01, coluna F)
}

model HomologacaoFornecedor {
  id         Int    @id @default(autoincrement())
  numero     String @unique // HFOR0001/2026
  ano        Int
  sequencial Int
  semana     String // W28 - mesma regra de semana do SQE e da Manufatura

  // --- Cabecalho da autoavaliacao (FMR.024.03, pagina 01 de 03) ---
  fornecedorNome    String
  cnpj              String?
  inscricaoEstadual String?
  responsavelInfo   String?
  setor             String?
  // Data em que a Qualidade lancou as respostas do fornecedor. Vazia enquanto
  // o registro esta aguardando o retorno.
  dataAvaliacao     DateTime?

  // Respostas do fornecedor: [{ codigo: "A1", resposta: "SIM"|"NAO"|"NA" }]
  respostas Json?

  // Resultado calculado (abas "Criterios" e "Resultados"):
  // [{ bloco, nome, peso, pontuacao, ponderada, critico, reprovadas: [...] }]
  blocos    Json?
  nota      Float? // nota ponderada final, 0 a 100
  resultado ResultadoHomologacao?

  // --- Registro de homologacao (FMR.029.01, aba "2026") ---
  codigoFornecedor       String?
  solicitante            SolicitanteSqd?
  segmento               String?
  escopoFornecedor       String?
  processosTerceirizados String?
  // Abre o registro e serve de marco zero dos tres relogios. A tela exige a
  // data; no banco a coluna segue opcional por causa dos registros abertos
  // antes da inversao do fluxo.
  dataSolicitacao        DateTime?
  dataEnvioRelatorio     DateTime?
  leadTimeDiasUteis      Int? // dias uteis entre a solicitacao e o envio do relatorio
  // Resposta do fornecedor: prazo de 3 dias uteis a partir da solicitacao.
  dataRetornoFornecedor  DateTime?
  tempoRespostaDiasUteis Int?
  // Fechamento do ciclo: carimbado quando o status vai para FINALIZADO.
  dataFinalizacao        DateTime?
  tempoTotalDiasUteis    Int?
  statusHomologacao      StatusHomologacao     @default(EM_ANDAMENTO)
  statusPlanoAcao        StatusPlanoAcaoSqd?
  dataReavaliacao        DateTime?
  efetividadePlanoAcao   EfetividadePlanoAcao?
  acao                   String?
  observacoes            String?

  // Anexos (tabela polimorfica Anexo):
  //   "HOMOLOGACAO_RELATORIO"   - relatorio final escrito pela Qualidade
  //   "HOMOLOGACAO_PLANO_ACAO"  - plano de acao enviado pelo fornecedor

  criadoPorId Int?
  criadoPor   Usuario? @relation("HomologacaoCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ano, sequencial])
  @@index([dataSolicitacao])
}

// ---------------------------------------------------------------------------
// SQD - HOMOLOGACAO DE ITENS - Doc BDBR.QUA.FMR.025.01 (aba "Lista")
//
// Mesmo fluxo da homologacao de fornecedores, com uma troca: no lugar da
// autoavaliacao do fornecedor entra o relatorio de inspecao (abas AMOSTRAS e
// VISUAL do modelo de relatorios). O item so e aprovado quando as duas abas
// sao aprovadas.
//
// Cada tentativa e um relatorio novo sob o MESMO numero do registro; a revisao
// do relatorio e o proprio numero da tentativa (01, 02...).

enum MotivoHomologacaoItem {
  PRIMEIRO_FORNECIMENTO
  ALTERACAO_MATERIAL
  ALTERACAO_PROCESSO
}

// Aqui nao existe "Aprovado Condicionalmente" (que so faz sentido para o
// fornecedor) e "Cancelado" e um resultado, alem de ser um status.
enum ResultadoHomologacaoItem {
  APROVADO
  REPROVADO
  CANCELADO
}

model HomologacaoItem {
  id         Int    @id @default(autoincrement())
  numero     String @unique // HITE0001/2026
  ano        Int
  sequencial Int
  semana     String // W28 - mesma regra de semana do resto do sistema

  // --- Informacoes do item e do fornecedor ---
  fornecedorNome   String
  codigoFornecedor String?
  itemCodigo       String?
  itemDescricao    String?

  // --- Informacoes do documento ---
  solicitante  SolicitanteSqd?
  motivo       MotivoHomologacaoItem?
  // "Custo potencial evitado" (coluna K): entra no savings do painel.
  custoEvitado Float?

  // Abre o registro e serve de marco zero dos tres relogios.
  dataSolicitacao        DateTime?
  dataEnvioRelatorio     DateTime?
  leadTimeDiasUteis      Int?
  dataRetornoFornecedor  DateTime?
  tempoRespostaDiasUteis Int?
  dataFinalizacao        DateTime?
  tempoTotalDiasUteis    Int?

  // --- Analise ---
  // Sai do relatorio de inspecao da ultima tentativa (ou CANCELADO na mao).
  resultado            ResultadoHomologacaoItem?
  statusHomologacao    StatusHomologacao         @default(EM_ANDAMENTO)
  statusPlanoAcao      StatusPlanoAcaoSqd?
  dataReavaliacao      DateTime?
  efetividadePlanoAcao EfetividadePlanoAcao?
  acao                 String?
  observacoes          String?

  // Desvio de qualidade: mesma regra da RNC - quantidade de pecas, prazo, ou
  // os dois (ao menos um e obrigatorio), com documento anexo obrigatorio.
  desvioQualidade       Boolean   @default(false)
  desvioAberturaEm      DateTime?
  desvioQuantidade      Float?
  desvioPrazoFim        DateTime?
  desvioDescricao       String?
  desvioEncerradoEm     DateTime?
  desvioEncerramentoObs String?

  // Anexos (tabela polimorfica Anexo):
  //   "HOMOLOGACAO_ITEM_RELATORIO"  - relatorio final escrito pela Qualidade
  //   "HOMOLOGACAO_ITEM_PLANO_ACAO" - plano de acao enviado pelo fornecedor
  //   "HOMOLOGACAO_ITEM_DESVIO"     - documento que autoriza o desvio

  relatorios RelatorioInspecaoItem[]

  criadoPorId Int?
  criadoPor   Usuario? @relation("HomologacaoItemCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ano, sequencial])
  @@index([dataSolicitacao])
}

// Relatorio de inspecao da homologacao de itens. Nao tem numero proprio:
// carrega o numero do registro mais a revisao (ex.: HITE0001/2026 - Rev. 02).
model RelatorioInspecaoItem {
  id            Int             @id @default(autoincrement())
  homologacaoId Int
  homologacao   HomologacaoItem @relation(fields: [homologacaoId], references: [id], onDelete: Cascade)

  tentativa Int    @default(1)
  revisao   String @default("01") // sempre igual a tentativa, com dois digitos

  // --- CABECALHO do modelo de relatorios ---
  dataInspecao    DateTime?
  origem          OrigemInspecao @default(HOMOLOGACAO)
  // Ver RelatorioDimensional: desenhoRev e o legado e a revisao do desenho se
  // chama desenhoRevisao para nao colidir com a revisao do relatorio.
  desenhoRev      String?
  desenho         String?
  desenhoRevisao  String?
  // Peca de conjunto: desenhos EXTRAS, do 2o em diante ([{ desenho, revisao }]).
  // O 1o continua nos campos acima e cada cota diz a qual desenho pertence pelo
  // "desenhoIdx". Ver comum/inspecao.ts (gruposDeDesenho).
  desenhos        Json?
  tolerancias     String?
  nf              String?
  po              String?
  qtdInspecionada Float?
  qtdTotal        Float?
  elaboradoPor    String?
  inspecionadoPor String?

  // --- Aba AMOSTRAS (FMR.011.06 rev. 06) ---
  // [{ localizacao, especificado, tolerancia, upper, lower, pecas: [...],
  //    instrumento, desvioMin, desvioMax }]
  cotas               Json?
  observacoesAmostras String?
  resultadoAmostras   ResultadoInspecao?

  // --- Aba VISUAL (FMR.06.07 rev. 07) ---
  // [{ grupo, itens: [{ texto, status: APROVADO|REPROVADO|NAO_APLICAVEL }] }]
  checklistVisual   Json?
  evidenciasVisual  String?
  observacoesVisual String?
  resultadoVisual   ResultadoInspecao?

  // Ver InspecaoVisual: relatorio salvo pela metade. Nao apura o resultado do
  // item nem entra nos indicadores do SQD ate ser lancado.
  rascunho Boolean @default(false)

  criadoPorId Int?
  criadoPor   Usuario? @relation("RelatorioItemCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([homologacaoId, tentativa])
}

// ---------------------------------------------------------------------------
// SQD - AUDITORIA DE FORNECEDORES - planilha "Checklist Auditoria"
// (abas Checklist, Pontuacao e Resumo) + relatorio de auditoria (RT).
//
// 46 perguntas distribuidas em 12 blocos com peso. A nota e a media ponderada
// dos blocos, normalizada pela soma dos pesos dos blocos avaliados (bloco
// inteiro em N/A sai da conta e o restante se rebalanceia sozinho).
//
// A auditoria e um evento: um registro por auditoria, com N rodadas dentro.
// A rodada 01 e a auditoria inicial; as seguintes sao as reavaliacoes.
// Reprovado reavalia em 90 dias corridos, aprovado condicionalmente em 180,
// sempre contados da data da rodada que gerou o resultado. O ciclo so termina
// quando a Qualidade encerra a auditoria.

enum ResultadoAuditoria {
  APROVADO // nota >= 90
  APROVADO_CONDICIONALMENTE // nota de 80 a 89,99
  REPROVADO // nota < 80
  CANCELADO
}

enum StatusAuditoria {
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
}

model AuditoriaFornecedor {
  id         Int    @id @default(autoincrement())
  numero     String @unique // AUD0001/2026
  ano        Int
  sequencial Int
  semana     String // W28 - mesma regra de semana do resto do sistema

  // --- Cabecalho do checklist (aba "Checklist (2)", linhas 2 a 6) ---
  fornecedorNome   String
  cnpj             String?
  codigoFornecedor String?
  motivo           String? // motivo da auditoria
  local            String? // local de realizacao
  auditores        String? // auditores responsaveis
  participantes    String? // participantes do fornecedor
  dataAuditoria    DateTime? // data da auditoria inicial (rodada 01)

  // --- Espelho da ultima rodada lancada ---
  dataUltimaRodada DateTime?
  nota             Float? // 0 a 100, ja normalizada
  resultado        ResultadoAuditoria?

  // Prazo de reavaliacao em dias corridos (90 reprovado / 180 condicional),
  // contado a partir da data da rodada que gerou o resultado.
  prazoReavaliacaoDias  Int?
  dataLimiteReavaliacao DateTime?

  conclusao   String? // conclusao/recomendacao da Qualidade
  observacoes String?

  statusAuditoria StatusAuditoria @default(EM_ANDAMENTO)
  dataFinalizacao DateTime?

  // Anexos (tabela polimorfica Anexo):
  //   "AUDITORIA_RELATORIO"  - relatorio final escrito pela Qualidade
  //   "AUDITORIA_PLANO_ACAO" - plano de acao enviado pelo fornecedor

  rodadas RodadaAuditoria[]

  criadoPorId Int?
  criadoPor   Usuario? @relation("AuditoriaCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ano, sequencial])
  @@index([dataAuditoria])
}

// Rodada da auditoria: o checklist preenchido de uma passada. Nao tem numero
// proprio: carrega o numero do registro mais a revisao (ex.: AUD0001/2026 - Rev. 02).
model RodadaAuditoria {
  id          Int                 @id @default(autoincrement())
  auditoriaId Int
  auditoria   AuditoriaFornecedor @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  rodada  Int    @default(1)
  revisao String @default("01") // sempre igual ao numero da rodada, com dois digitos

  dataAuditoria DateTime?
  auditores     String?
  participantes String?
  local         String?

  // Respostas do checklist:
  // [{ codigo: "4.1.1", resposta: "SIM"|"PARCIAL"|"NAO"|"NAO_APLICAVEL", evidencia }]
  respostas Json?

  // Resultado por bloco (aba "Resumo"):
  // [{ bloco, nome, peso, pontuacao, ponderada, classificacao, respondidas }]
  blocos    Json?
  nota      Float?
  resultado ResultadoAuditoria?

  conclusao   String?
  observacoes String?

  criadoPorId Int?
  criadoPor   Usuario? @relation("RodadaAuditoriaCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([auditoriaId, rodada])
}

// ---------------------------------------------------------------------------
// INVENTARIO DE INSTRUMENTOS E EQUIPAMENTOS - BDBR.QUA.FMR.004.01
//
// Copia fiel das nove colunas da planilha. Duas observacoes que vieram do
// arquivo real e mandam no modelo:
//   - o CODIGO nao e chave: 35 linhas vem com "-" e varios codigos aparecem
//     repetidos (a barra padrao herda o codigo do micrometro a que pertence).
//     Por isso e texto opcional, sem @unique.
//   - PROXIMA CALIBRACAO e campo gravado, nao conta. Nas 52 linhas do arquivo
//     ela e sempre calibracao + 730 dias enquanto o PERIODO (ANOS) esta
//     preenchido com 1 - quem vale e a data do certificado. O sistema apenas
//     SUGERE "calibracao + periodo" quando o campo vem vazio.
// ---------------------------------------------------------------------------
model Instrumento {
  id          Int     @id @default(autoincrement())
  codigo      String?
  equipamento String
  fabricante  String?
  numeroSerie String?

  dataCalibracao    DateTime?
  periodoAnos       Int?
  proximaCalibracao DateTime?
  numeroCertificado String?

  localizacao String?
  observacoes String?

  // Cadastro nao se apaga por padrao: inativa. Instrumento inativo sai do
  // inventario e do controle de vencimento, mas o registro continua.
  ativo Boolean @default(true)

  criadoPorId Int?
  criadoPor   Usuario? @relation("InstrumentoCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ativo])
  @@index([proximaCalibracao])
}

// ---------------------------------------------------------------------------
// R.O - Gestao de Reclamacoes da Qualidade
//
// Copia da planilha "especificacao_controle_reclamacoes_qualidade.xlsx". E o
// controle INTERNO da Qualidade sobre a reclamacao que chega da Sala de
// Controle: nao substitui o formulario do SAC, comeca a partir dele.
//
// A planilha tem quatro blocos e o sistema marca cada um como concluido
// sozinho, assim que os campos daquele bloco estao preenchidos - por isso o
// flag mora numa tabela filha (BlocoReclamacao), e nao em colunas soltas.
// ---------------------------------------------------------------------------

enum CompletudeSacRo {
  SIM
  NAO
  PARCIAL
}

enum AceiteRo {
  SIM
  NAO
  AGUARDANDO
}

enum SimNaoRo {
  SIM
  NAO
}

enum ClassificacaoRo {
  DEFEITO_FUNCIONAL
  FALHA_DESEMPENHO
  PROBLEMA_DIMENSIONAL
  MATERIAL_INCORRETO
  QUANTIDADE_INCORRETA
  EMBALAGEM
  DOCUMENTACAO
  MONTAGEM_INSTALACAO
  SOFTWARE_COMUNICACAO
  ENTREGA_LOGISTICA
  SEGURANCA
  BEM_ESTAR_ANIMAL
  MEIO_AMBIENTE
  OUTRO
}

enum ProcedenciaRo {
  PROCEDENTE
  PARCIALMENTE_PROCEDENTE
  NAO_PROCEDENTE
  INCONCLUSIVA
}

enum AreaResponsavelRo {
  QUALIDADE_PRODUCAO
  SQE
  SQD
  ENGENHARIA
  LOGISTICA
  SERVICO_ASSISTENCIA
  EQUIPE_MULTIFUNCIONAL
}

enum PrioridadeRo {
  CRITICA
  ALTA
  MEDIA
  BAIXA
}

enum MetodoAnaliseRo {
  CINCO_PORQUES
  ISHIKAWA
  PARETO
  FMEA
  OITO_D
  TESTE_REPRODUCAO
  ANALISE_DADOS
  AUDITORIA
  OUTRO
}

enum StatusAcaoRo {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  ATRASADA
  CANCELADA
}

enum EficaciaRo {
  EFICAZ
  PARCIALMENTE_EFICAZ
  INEFICAZ
  NAO_APLICAVEL
}

enum MotivoEncerramentoRo {
  PROCEDENTE_COM_ACAO
  NAO_PROCEDENTE
  DUPLICADA
  CANCELADA
  INCONCLUSIVA
}

enum StatusRo {
  RECEBIDA_SAC
  EM_TRIAGEM
  AGUARDANDO_SAC
  DIRECIONADA
  CONTENCAO
  INVESTIGACAO
  ACOES_CORRETIVAS
  AGUARDANDO_EFICACIA
  RETORNO_SAC
  ENCERRADA
  REABERTA
  NAO_ACEITA
}

// O plano de contencao e as acoes corretivas sao a mesma coisa em forma: linhas
// de tarefa com responsavel, prazo e situacao. O tipo separa as duas listas.
enum TipoTarefaRo {
  CONTENCAO
  ACAO_CORRETIVA
}

model Reclamacao {
  id         Int    @id @default(autoincrement())
  numero     String @unique // RO-2026-0001
  ano        Int
  sequencial Int

  // --- 1. Dados recebidos (o que a Sala de Controle mandou) ---
  // Sao digitados pela Qualidade conforme o formulario recebido: nao existe
  // modulo de SAC no sistema.
  cliente             String?
  produtoCodigo       String?
  produtoDescricao    String?
  quantidadeAfetada   Float?
  valorUnitario       Float?
  tipoInformado       String?
  resultadoAnaliseSac String?
  origemIndicada      String?
  // Carimbo automatico da chegada na Qualidade: e dele que sai o prazo.
  recebidoEm          DateTime @default(now())

  // --- 2. Triagem e direcionamento da Qualidade ---
  dadosCompletos  CompletudeSacRo?
  aceita          AceiteRo?
  classificacao   ClassificacaoRo?
  procedencia     ProcedenciaRo?
  prioridade      PrioridadeRo?
  areaResponsavel AreaResponsavelRo?
  responsavelId   Int?
  responsavel     Usuario?           @relation("ReclamacaoResponsavel", fields: [responsavelId], references: [id])
  // Recebimento + 5 dias uteis, calculado pelo sistema.
  prazoConclusao  DateTime?
  pendenciasSac   String?
  // Quantidade afetada x valor unitario, calculado pelo sistema.
  custoTotal      Float?

  // --- 3. Tratativa interna ---
  necessidadeContencao SimNaoRo?
  metodoAnalise        MetodoAnaliseRo?
  causaImediata        String?
  causaSistemica       String?
  // Situacao geral das acoes corretivas, resumida das linhas do plano.
  statusAcoes          StatusAcaoRo?
  verificacaoEficacia  EficaciaRo?
  evidencias           String?

  // --- 4. Retorno ao SAC e encerramento ---
  resumoConclusao    String?
  dataRetornoSac     DateTime?
  motivoEncerramento MotivoEncerramentoRo?
  status             StatusRo              @default(RECEBIDA_SAC)

  tarefas TarefaReclamacao[]
  blocos  BlocoReclamacao[]

  criadoPorId Int?
  criadoPor   Usuario? @relation("ReclamacaoCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ano, sequencial])
  @@index([recebidoEm])
  @@index([status])
}

// Uma linha do plano de contencao ou do plano de acoes corretivas.
model TarefaReclamacao {
  id           Int        @id @default(autoincrement())
  reclamacaoId Int
  reclamacao   Reclamacao @relation(fields: [reclamacaoId], references: [id], onDelete: Cascade)

  tipo        TipoTarefaRo
  ordem       Int
  descricao   String
  responsavel String?
  prazo       DateTime?
  status      StatusAcaoRo @default(NAO_INICIADA)

  @@index([reclamacaoId, tipo])
}

// Flag de bloco concluido. A propria existencia da linha e o flag: o sistema
// cria quando o bloco fica completo e apaga se algum campo dele for esvaziado.
model BlocoReclamacao {
  id           Int        @id @default(autoincrement())
  reclamacaoId Int
  reclamacao   Reclamacao @relation(fields: [reclamacaoId], references: [id], onDelete: Cascade)

  numero      Int // 1 a 4
  concluidoEm DateTime @default(now())

  concluidoPorId Int?
  concluidoPor   Usuario? @relation("BlocoReclamacaoConcluidoPor", fields: [concluidoPorId], references: [id])

  @@unique([reclamacaoId, numero])
}

// ---------------------------------------------------------------------------
// CALENDARIO DE FERIADOS
//
// Alimenta a contagem de DIAS UTEIS de todo o sistema: o prazo da R.O, os
// prazos do SQD e os indicadores de prazo do painel do SQE. Sem esta tabela a
// contagem seria so segunda-a-sexta e um prazo de 5 dias que cai no Carnaval
// venceria com a fabrica fechada.
//
// Toda linha aqui e um dia NAO util - o "tipo" e so a etiqueta que explica de
// onde o dia veio. Ponto facultativo que a fabrica para (Carnaval, Corpus
// Christi) entra na lista do mesmo jeito, porque o que importa e se tem gente
// trabalhando.
//
// A lista nasce gerada (nacionais + estaduais de SP + municipais de
// Araraquara) e a Qualidade completa a mao com o que for da casa: recesso de
// fim de ano, parada de manutencao, ponte.
// ---------------------------------------------------------------------------
enum TipoFeriado {
  NACIONAL
  ESTADUAL
  MUNICIPAL
  FACULTATIVO
  PARADA // parada da fabrica: recesso, manutencao, ponte
}

model Feriado {
  id        Int         @id @default(autoincrement())
  // So a data importa: sem hora, para a comparacao ser exata em qualquer fuso.
  data      DateTime    @unique @db.Date
  descricao String
  tipo      TipoFeriado @default(NACIONAL)

  criadoPorId Int?
  criadoPor   Usuario? @relation("FeriadoCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([data])
}
