# ===== Configuracao do Sistema de Qualidade (SQE) =====
#
# Este arquivo e o modelo do ".env" usado pelo docker-compose.yml da RAIZ, que
# e a instalacao no servidor da empresa (Postgres, backend e frontend em
# containers na propria maquina). A instalacao em nuvem NAO usa este arquivo:
# la as variaveis sao cadastradas no painel do provedor - ver DEPLOY.md.
#
# Copie para ".env" na raiz do projeto e preencha antes de subir:
#     cp .env.example .env
#
# O ".env" tem senha dentro e esta no .gitignore. Nunca versione.


# ---------------------------------------------------------------------------
# OBRIGATORIAS - sem qualquer uma destas o sistema NAO sobe
# ---------------------------------------------------------------------------

# Usuario administrador criado no primeiro boot.
# A senha precisa de 12 caracteres ou mais: o proprio seed recusa menos que
# isso e o container para. Nao existe senha padrao, de proposito.
SEED_ADMIN_EMAIL=qualidade@suaempresa.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha-por-uma-de-12-ou-mais

# Chave secreta que assina os tokens de login (JWT).
# Gere uma aleatoria e guarde: trocar depois desloga todo mundo.
#     openssl rand -hex 48
JWT_SECRET=troque-esta-chave-secreta-por-um-texto-longo-e-aleatorio

# Banco de dados PostgreSQL (roda dentro do proprio Docker).
# O docker-compose monta a DATABASE_URL e a DIRECT_URL a partir destes tres.
POSTGRES_USER=qualidade
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=qualidade


# ---------------------------------------------------------------------------
# OPCIONAIS - tem padrao e funcionam em branco
# ---------------------------------------------------------------------------

# Porta em que o sistema fica acessivel na rede local. Padrao: 8080.
# Ex: http://IP-DO-SERVIDOR:8080
APP_PORT=8080

# Fuso horario do servidor. Padrao: America/Sao_Paulo.
# O sistema guarda toda data em UTC, mas pergunta "que dia e hoje" no relogio
# local - prazo de RNC, vencimento de calibracao e a competencia do IDF. Num
# container sem esta variavel o relogio e UTC e, das 21h a meia-noite, a
# fabrica enxergaria o dia seguinte.
TZ=America/Sao_Paulo

# Enderecos autorizados a chamar a API, separados por virgula.
# Em branco a API aceita qualquer origem, que e como sempre funcionou.
# Preencha para fechar - use o endereco pelo qual as pessoas abrem o sistema.
# Ex: CORS_ORIGINS=http://192.168.0.50:8080,http://qualidade.suaempresa.local
CORS_ORIGINS=


# ---------------------------------------------------------------------------
# NAO precisam estar aqui
# ---------------------------------------------------------------------------
# DATABASE_URL, DIRECT_URL, UPLOAD_DIR e PORT sao definidas pelo
# docker-compose.yml. Os anexos vao para o volume "uploads_data" (UPLOAD_DIR),
# no disco do servidor - as variaveis SUPABASE_* so valem na instalacao em
# nuvem, onde o anexo fica no bucket.
