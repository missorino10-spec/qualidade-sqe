# ===== Configuracao do Sistema de Qualidade (SQE) =====
# Copie este arquivo para ".env" e ajuste os valores antes de subir.

# Porta em que o sistema fica acessivel na rede local.
# Ex: http://IP-DO-SERVIDOR:8080
APP_PORT=8080

# Banco de dados PostgreSQL (roda dentro do proprio Docker)
POSTGRES_USER=qualidade
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=qualidade

# Chave secreta usada para gerar os tokens de login (JWT).
# Troque por um texto longo e aleatorio.
JWT_SECRET=troque-esta-chave-secreta-por-um-texto-longo-e-aleatorio
